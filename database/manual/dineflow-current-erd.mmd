    SALES_CHANNELS ||--o{ CHOICE_ITEM_CHANNEL_PRICES : prices
    SALES_CHANNELS ||--o{ ORDERS : source_for
    MENU_ITEMS ||--o{ MENU_ITEM_CHANNEL_PRICES : has
    CHOICE_ITEMS ||--o{ CHOICE_ITEM_CHANNEL_PRICES : has

    TABLE_SESSIONS ||--o{ TABLE_SESSION_CUSTOMERS : has
    TABLE_SESSIONS ||--o{ ORDERS : has
