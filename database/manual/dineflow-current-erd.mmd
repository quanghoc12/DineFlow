    USERS ||--o{ SERVICE_REQUESTS : confirms
    USERS ||--o{ BILLS : creates
    USERS ||--o{ BILLS : cancels
    USERS ||--o{ BILL_DETAIL_ADJUSTMENTS : creates
    USERS ||--o{ PAYMENTS : confirms
    USERS ||--o{ PAYMENTS : updates

