    TABLE_SESSIONS ||--o{ SERVICE_REQUESTS : has
    TABLE_SESSION_CUSTOMERS ||--o{ SERVICE_REQUESTS : sends

    ORDERS ||--o{ ORDER_ITEMS : contains
    MENU_ITEMS ||--o{ ORDER_ITEMS : ordered_as
