erDiagram
    USERS {
        int UserId PK
        string Username UK
        string PasswordHash
        string FullName
        string Role
        bool IsActive
        datetime CreatedAt
        datetime UpdatedAt
    }

    AREAS {
        int AreaId PK
        string AreaName UK
        int DisplayOrder
        bool IsActive
        datetime CreatedAt
        datetime UpdatedAt
    }

    DINING_TABLES {
        int TableId PK
        string TableName
        int AreaId FK "nullable"
        string Area "legacy/display area"
        string QrToken UK
        string Status "Available, Occupied, WaitingPayment"
        bool IsActive
        int DisplayOrder
        datetime CreatedAt
        datetime UpdatedAt
    }

    CATEGORIES {
        int CategoryId PK
        string CategoryName
        string Description
        int DisplayOrder
        bool IsActive
        datetime CreatedAt
        datetime UpdatedAt
    }

    MENU_ITEMS {
        int MenuItemId PK
        int CategoryId FK
        string Name
        string Description
        decimal BasePrice
        string ImageUrl
        bool IsAvailable
        bool IsDeleted
        bool IsOutOfStock
        int Stock "nullable; null means no stock tracking"
        datetime CreatedAt
        datetime UpdatedAt
    }

    CHOICE_GROUPS {
        int ChoiceGroupId PK
        string GroupName
        bool IsAvailable
        bool IsRequired
        int MaxSelectDefault
        datetime CreatedAt
        datetime UpdatedAt
    }

    CHOICE_ITEMS {
        int ChoiceItemId PK
        int ChoiceGroupId FK
        string ChoiceName
        decimal ExtraPrice
        bool IsAvailable
        datetime CreatedAt
        datetime UpdatedAt
    }

    MENU_ITEM_CHOICE_GROUPS {
        int MenuItemId PK, FK
        int ChoiceGroupId PK, FK
        int DisplayOrder
        int MaxSelect "nullable override"
        datetime CreatedAt
        datetime UpdatedAt
    }

    SALES_CHANNELS {
        int SalesChannelId PK
        string ChannelCode UK "unique when IsDeleted=false"
        string ChannelName
        bool IsActive
        bool IsDeleted
        datetime CreatedAt
        datetime UpdatedAt
    }

    MENU_ITEM_CHANNEL_PRICES {
        int MenuItemId PK, FK
        int SalesChannelId PK, FK
        decimal ChannelExtraPrice
        datetime CreatedAt
        datetime UpdatedAt
    }

    CHOICE_ITEM_CHANNEL_PRICES {
        int ChoiceItemId PK, FK
        int SalesChannelId PK, FK
        decimal ChannelExtraPrice
        datetime CreatedAt
        datetime UpdatedAt
    }

    TABLE_SESSIONS {
        int TableSessionId PK
        int TableId FK
        datetime StartedAt
        datetime EndedAt
        string Status "Browsing, Open, WaitingPayment, Closed, Cancelled"
        int OpenedBy FK "nullable"
        int ClosedBy FK "nullable"
    }

    TABLE_SESSION_CUSTOMERS {
        int SessionCustomerId PK
        int TableSessionId FK
        string ClientToken
        string DisplayName
        datetime CreatedAt
    }

    ORDERS {
        int OrderId PK
        int TableSessionId FK
        int SessionCustomerId FK "nullable for staff order"
        int SalesChannelId FK
        string OrderCode UK
        string OrderSource
        string ExternalOrderCode
        string ClientToken
        string Status
        string PrintStatus
        string CustomerNote
        string SystemNote
        string CancelReason
        datetime CreatedAt
        datetime UpdatedAt
        datetime CancelledAt
        datetime PrintedAt
        string PrintError
        int CreatedBy FK "nullable"
        int CancelledBy FK "nullable"
    }

    ORDER_ITEMS {
        int OrderItemId PK
        int OrderId FK
        int MenuItemId FK
        string MenuItemNameSnapshot
        decimal BasePriceSnapshot
        decimal ChannelExtraPriceSnapshot
        decimal FinalUnitPriceSnapshot
        int Quantity
        string Note
        datetime CreatedAt
        datetime UpdatedAt
    }

    ORDER_ITEM_SELECTED_CHOICES {
        int OrderItemSelectedChoiceId PK
        int OrderItemId FK
        int ChoiceGroupId FK
        int ChoiceItemId FK
        string GroupNameSnapshot
        string ChoiceNameSnapshot
        decimal ExtraPriceSnapshot
        decimal ChannelExtraPriceSnapshot
        decimal FinalExtraPriceSnapshot
        datetime CreatedAt
    }

    SERVICE_REQUESTS {
        int RequestId PK
        int TableSessionId FK
        int SessionCustomerId FK "nullable"
        string ClientToken
        string RequestType "CallStaff, PaymentRequest"
        string Reason
        string PaymentMethod
        string Message
        string Status
        datetime CreatedAt
        datetime ConfirmedAt
        int ConfirmedBy FK "nullable"
    }

    BILLS {
        int BillId PK
        string BillCode UK
        int TableSessionId FK
        int SalesChannelId FK
        string SalesChannelCodeSnapshot
        string SalesChannelNameSnapshot
        int BillNo
        string BillName
        bool IsDefault
        string Status "Unpaid, Paid, Cancelled"
        decimal SubTotal
        decimal DiscountAmount
        decimal FinalAmount
        datetime CreatedAt
        int CreatedBy FK "nullable"
        datetime PaidAt
        datetime CancelledAt
        int CancelledBy FK "nullable"
        string CancelReason
    }

    BILL_DETAILS {
        int BillDetailId PK
        int BillId FK
        int MenuItemId FK
        int SalesChannelId FK
        string ItemName
        string ChoiceSummary
        string Note
        int Quantity
        int NotifiedQuantity
        decimal BasePriceSnapshot
        decimal MenuItemChannelExtraPriceSnapshot
        decimal ChoiceExtraPriceSnapshot
        decimal UnitPrice
        decimal TotalPrice
        datetime CreatedAt
    }

    BILL_DETAIL_ADJUSTMENTS {
        int BillDetailAdjustmentId PK
        int BillId FK
        int BillDetailId FK
        int MenuItemId FK
        string ItemName
        int QuantityBefore
        int QuantityAfter
        int ChangedQuantity
        string ChangeType
        string Reason
        datetime CreatedAt
        int CreatedBy FK
    }

    PAYMENTS {
        int PaymentId PK
        int BillId FK
        string PaymentMethod
        decimal Amount
        datetime PaidAt
        int ConfirmedBy FK
        datetime UpdatedAt
        int UpdatedBy FK "nullable"
        string ChangeReason
    }

    USERS ||--o{ TABLE_SESSIONS : opens
