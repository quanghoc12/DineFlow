<UserControl x:Class="DineFlow.WPFApp.Features.Billing.Cancellation.CancellationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Shared/ReportWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Style="{StaticResource ReportWorkspaceRootStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Title Header -->
                <Border Style="{StaticResource ReportWorkspaceHeaderBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Thống kê yêu cầu hủy" FontSize="27" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Xem chi tiết các hóa đơn và món ăn bị hủy bởi hệ thống hoặc nhân viên."
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource ReportWorkspaceHeaderTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Date Picker Filter -->
                <Border Style="{StaticResource ReportWorkspacePanelStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Chọn ngày xem" Style="{StaticResource ReportWorkspaceFilterLabelStyle}" />
                        <DatePicker Grid.Column="1" SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Style="{StaticResource ReportWorkspaceDatePickerStyle}" />

                        <Button Grid.Column="3"
                                Content="Tải lại"
                                Click="LoadButton_Click"
                                Width="120"
                                Style="{StaticResource ReportWorkspacePrimaryButtonStyle}" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C53030"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <!-- Counters/Metrics -->
                <UniformGrid Columns="2" Margin="0,0,0,16">
                    <Border Style="{StaticResource ReportWorkspaceMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SỐ MÓN ĂN BỊ HỦY" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                            <TextBlock Text="{Binding CancelledItemCount}" Margin="0,10,0,0" FontSize="24" FontWeight="Bold" Foreground="#EF4444" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ReportWorkspaceMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SỐ HÓA ĐƠN BỊ HỦY" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                            <TextBlock Text="{Binding CancelledBillCount}" Margin="0,10,0,0" FontSize="24" FontWeight="Bold" Foreground="#DC2626" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Tabs containing Subgrids -->
                <Border Style="{StaticResource ReportWorkspacePanelStyle}">
                    <TabControl Background="Transparent" BorderThickness="0" Padding="0,10,0,0">
                        <!-- Sub-tab 1: Món Bị Hủy -->
                        <TabItem Header="Món bị hủy" Width="150" Height="36" FontSize="14" FontWeight="SemiBold">
                            <Grid Margin="0,10,0,0">
                                <DataGrid ItemsSource="{Binding CancelledItems}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E2E8F0"
                                          RowHeaderWidth="0"
                                          CanUserAddRows="False"
                                          MinHeight="250">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tên món" Binding="{Binding ItemName}" Width="*" />
                                        <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="80" />
                                        <DataGridTextColumn Header="Bàn" Binding="{Binding TableName}" Width="100" />
                                        <DataGridTextColumn Header="Khu vực" Binding="{Binding Area}" Width="100" />
                                        <DataGridTextColumn Header="Nguồn hủy" Binding="{Binding Source}" Width="100" />
                                        <DataGridTextColumn Header="Thời gian hủy" Binding="{Binding CancelledAt, StringFormat=dd/MM/yyyy HH:mm}" Width="150" />
                                        <DataGridTextColumn Header="Người hủy" Binding="{Binding CancelledByName}" Width="130" />
                                        <DataGridTextColumn Header="Lý do hủy" Binding="{Binding CancelReason}" Width="200" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- Sub-tab 2: Bill Bị Hủy -->
                        <TabItem Header="Bill bị hủy" Width="150" Height="36" FontSize="14" FontWeight="SemiBold">
                            <Grid Margin="0,10,0,0">
                                <DataGrid ItemsSource="{Binding CancelledBills}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E2E8F0"
                                          RowHeaderWidth="0"
                                          CanUserAddRows="False"
                                          MinHeight="250">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã Bill" Binding="{Binding BillCode}" Width="120" />
                                        <DataGridTextColumn Header="Tên Bill" Binding="{Binding BillName}" Width="*" />
                                        <DataGridTextColumn Header="Bàn" Binding="{Binding TableName}" Width="100" />
                                        <DataGridTextColumn Header="Khu vực" Binding="{Binding Area}" Width="100" />
                                        <DataGridTextColumn Header="Tổng bill" Binding="{Binding FinalAmount, StringFormat={}{0:N0} đ}" Width="120" />
                                        <DataGridTextColumn Header="Thời gian hủy" Binding="{Binding CancelledAt, StringFormat=dd/MM/yyyy HH:mm}" Width="150" />
                                        <DataGridTextColumn Header="Người hủy" Binding="{Binding CancelledByName}" Width="130" />
                                        <DataGridTextColumn Header="Lý do hủy" Binding="{Binding CancelReason}" Width="200" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Busy Overlay -->
        <Border Background="#99FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Đang tải danh sách hủy..."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#102A43" />
        </Border>
    </Grid>
</UserControl>
