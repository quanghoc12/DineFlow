<UserControl x:Class="DineFlow.WPFApp.Features.Billing.Revenue.RevenueReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Shared/ReportWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Style="{StaticResource ReportWorkspaceRootStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Title Header -->
                <Border Style="{StaticResource ReportWorkspaceHeaderBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Báo cáo doanh thu" FontSize="27" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Xem chi tiết doanh thu theo ngày và chỉnh sửa phương thức thanh toán."
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource ReportWorkspaceHeaderTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Date Picker Filter -->
                <Border Style="{StaticResource ReportWorkspacePanelStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Chọn ngày xem" Style="{StaticResource ReportWorkspaceFilterLabelStyle}" />
                        <DatePicker Grid.Column="1" SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Style="{StaticResource ReportWorkspaceDatePickerStyle}" />

                        <Button Grid.Column="3"
                                Content="Tải lại"
                                Click="LoadButton_Click"
                                Width="120"
                                Style="{StaticResource ReportWorkspacePrimaryButtonStyle}" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C53030"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <!-- Summary Panel & Methods -->
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <Border Style="{StaticResource ReportWorkspaceMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="TỔNG DOANH THU" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                            <TextBlock Text="{Binding TotalRevenueText}" Margin="0,10,0,0" FontSize="22" FontWeight="Bold" Foreground="#102A43" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ReportWorkspaceMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="TIỀN MẶT" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                            <TextBlock Text="{Binding CashRevenueText}" Margin="0,10,0,0" FontSize="22" FontWeight="Bold" Foreground="#2F80ED" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ReportWorkspaceMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="CHUYỂN KHOẢN" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                            <TextBlock Text="{Binding BankTransferRevenueText}" Margin="0,10,0,0" FontSize="22" FontWeight="Bold" Foreground="#27AE60" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ReportWorkspaceMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="THẺ" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                            <TextBlock Text="{Binding CardRevenueText}" Margin="0,10,0,0" FontSize="22" FontWeight="Bold" Foreground="#F2994A" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- List of Daily Bills -->
                <Border Style="{StaticResource ReportWorkspacePanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Danh sách hóa đơn trong ngày" Style="{StaticResource ReportWorkspaceSectionTitleStyle}" Margin="0,0,0,12" />
                        
                        <DataGrid ItemsSource="{Binding Bills}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeaderWidth="0"
                                  CanUserAddRows="False"
                                  FontSize="14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã Bill" Binding="{Binding BillCode}" Width="150" />
                                <DataGridTextColumn Header="Bàn" Binding="{Binding TableName}" Width="120" />
                                <DataGridTextColumn Header="Thời gian" Binding="{Binding PaidAtText}" Width="150" />
                                <DataGridTextColumn Header="Tiền pay" Binding="{Binding PaymentsText}" Width="*" />
                                <DataGridTextColumn Header="Tổng bill" Binding="{Binding FinalAmountText}" Width="150" />
                                
                                <DataGridTemplateColumn Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Sửa đổi"
                                                    Click="EditPaymentButton_Click"
                                                    Style="{StaticResource TableSecondaryButtonStyle}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Padding="12,4"
                                                    Height="28" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Busy Overlay -->
        <Border Background="#99FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Đang tải báo cáo doanh thu..."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#102A43" />
        </Border>
    </Grid>
</UserControl>
