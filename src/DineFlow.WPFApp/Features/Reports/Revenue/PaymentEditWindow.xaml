<Window x:Class="DineFlow.WPFApp.Features.Reports.Revenue.PaymentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chỉnh sửa phương thức thanh toán"
        Width="500"
        Height="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Info -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="BillTitleText" Text="Hóa đơn: BILL001 - Bàn 5" Foreground="White" FontSize="16" FontWeight="Bold" />
                <TextBlock x:Name="BillTotalText" Text="Tổng tiền hóa đơn: 150,000 đ" Foreground="#94A3B8" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Payments Editor -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Chi tiết phương thức thanh toán" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PaymentsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,10" Background="White" Margin="0,0,0,8" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Payment Method Combobox -->
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Phương thức" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                                        <ComboBox SelectedValue="{Binding PaymentMethod, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  Height="32">
                                            <ComboBoxItem Content="Tiền mặt" Tag="Cash" />
                                            <ComboBoxItem Content="Chuyển khoản" Tag="BankTransfer" />
                                            <ComboBoxItem Content="Thẻ" Tag="Card" />
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <!-- Payment Amount Textbox -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Số tiền (đ)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Height="32" 
                                                 VerticalContentAlignment="Center" 
                                                 Padding="6,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Reason and Errors -->
        <StackPanel Grid.Row="2" Margin="0,16,0,16">
            <TextBlock Text="Lý do thay đổi (bắt buộc)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
            <TextBox x:Name="ReasonTextBox" Height="48" AcceptsReturn="True" TextWrapping="Wrap" Padding="8" VerticalScrollBarVisibility="Auto" BorderBrush="#CBD5E1" />
            
            <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Action Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="1" Content="Hủy bỏ" Click="CancelButton_Click" Width="100" Height="36" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" />
            <Button Grid.Column="2" Content="Lưu lại" Click="SaveButton_Click" Width="120" Height="36" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />
        </Grid>
    </Grid>
</Window>
