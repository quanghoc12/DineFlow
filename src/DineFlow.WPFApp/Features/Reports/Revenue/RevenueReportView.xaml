<UserControl x:Class="DineFlow.WPFApp.Features.Reports.Revenue.RevenueReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Reports/ReportWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Style="{StaticResource ReportWorkspaceRootStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource ReportWorkspaceHeaderBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Báo cáo doanh thu" FontSize="27" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Xem doanh thu theo khoảng ngày và xuất báo cáo đồng bộ với dashboard."
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource ReportWorkspaceHeaderTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ReportWorkspacePanelStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Từ ngày" Style="{StaticResource ReportWorkspaceFilterLabelStyle}" />
                        <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" Style="{StaticResource ReportWorkspaceDatePickerStyle}" />
                        <TextBlock Grid.Column="2" Text="Đến ngày" Style="{StaticResource ReportWorkspaceFilterLabelStyle}" />
                        <DatePicker Grid.Column="3" SelectedDate="{Binding ToDate}" Style="{StaticResource ReportWorkspaceDatePickerStyle}" />

                        <Button Grid.Column="5"
                                Content="Xem báo cáo"
                                Margin="0,0,8,0"
                                Click="LoadButton_Click"
                                Width="120"
                                Style="{StaticResource ReportWorkspacePrimaryButtonStyle}" />
                        <Button Grid.Column="6"
                                Content="CSV"
                                Margin="0,0,8,0"
                                Click="ExportCsvButton_Click"
                                Width="90"
                                Style="{StaticResource ReportWorkspaceSecondaryButtonStyle}" />
                        <Button Grid.Column="7"
                                Content="Excel"
                                Click="ExportExcelButton_Click"
                                Width="90"
                                Style="{StaticResource ReportWorkspaceSecondaryButtonStyle}" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C53030"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <Border Style="{StaticResource ReportWorkspaceMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Tổng doanh thu" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                            <TextBlock Text="{Binding TotalRevenueText}" Margin="0,10,0,0" FontSize="24" FontWeight="Bold" Foreground="#102A43" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ReportWorkspaceMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Số bill đã thanh toán" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                            <TextBlock Text="{Binding PaidBillCount}" Margin="0,10,0,0" FontSize="24" FontWeight="Bold" Foreground="#102A43" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,0,0" Padding="18" Background="#FFFFFF" CornerRadius="14">
                        <StackPanel>
                            <TextBlock Text="Giá trị bill trung bình" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                            <TextBlock Text="{Binding AverageBillValueText}" Margin="0,10,0,0" FontSize="24" FontWeight="Bold" Foreground="#102A43" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource ReportWorkspacePanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Doanh thu theo ngày" Style="{StaticResource ReportWorkspaceSectionTitleStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="46" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Background="#F4F7FA">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ngày" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Doanh thu" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Bill đã thanh toán" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="300">
                                <ItemsControl ItemsSource="{Binding RevenueByDays}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ManagementListRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="160" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Date, StringFormat=dd/MM/yyyy}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Revenue, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="2" Text="{Binding PaidBillCount}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Background="#99FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Đang tải báo cáo doanh thu..."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#102A43" />
        </Border>
    </Grid>
</UserControl>
