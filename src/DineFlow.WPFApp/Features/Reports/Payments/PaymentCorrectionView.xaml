<UserControl x:Class="DineFlow.WPFApp.Features.Reports.Payments.PaymentCorrectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Reports/ReportWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Style="{StaticResource ReportWorkspaceRootStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource ReportWorkspaceHeaderBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Payment correction"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="{Binding CurrentRoleText, StringFormat=Vai tro hien tai: {0}}"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource ReportWorkspaceHeaderTextBrush}" />
                        <TextBlock Text="Tính năng này chỉ dành cho Admin và Chủ nhà hàng."
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource ReportWorkspaceHeaderTextBrush}" />
                        <TextBlock Text="Nếu đi từ lịch sử bill paid, BillId sẽ được điền sẵn ở đây."
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource ReportWorkspaceHeaderTextBrush}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C53030"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding SuccessMessage}"
                           Foreground="#2F855A"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <Border Style="{StaticResource ReportWorkspacePanelStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="BillId" Style="{StaticResource ReportWorkspaceFilterLabelStyle}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding BillIdText}"
                                 Margin="8,0,16,0"
                                 VerticalContentAlignment="Center"
                                 Style="{StaticResource ReportWorkspaceTextBoxStyle}" />
                        <Button Grid.Column="2"
                                Content="Tải bill"
                                Click="LoadBillButton_Click"
                                Width="110"
                                Style="{StaticResource ReportWorkspacePrimaryButtonStyle}" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding BillSummaryText}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#102A43"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ReportWorkspacePanelStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Chọn payment cụ thể trong bill" Style="{StaticResource ReportWorkspaceSectionTitleStyle}" />
                        <DataGrid ItemsSource="{Binding Payments}"
                                  SelectedItem="{Binding SelectedPayment}"
                                  Style="{StaticResource ReportWorkspaceDataGridStyle}"
                                  MinHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PaymentId" Binding="{Binding PaymentId}" Width="90" />
                                <DataGridTextColumn Header="Phương thức" Binding="{Binding PaymentMethod}" Width="120" />
                                <DataGridTextColumn Header="Số tiền" Binding="{Binding AmountText}" Width="120" />
                                <DataGridTextColumn Header="PaidAt" Binding="{Binding PaidAtText}" Width="140" />
                                <DataGridTextColumn Header="ConfirmedBy" Binding="{Binding ConfirmedBy}" Width="100" />
                                <DataGridTextColumn Header="UpdatedAt" Binding="{Binding UpdatedAtText}" Width="140" />
                                <DataGridTextColumn Header="UpdatedBy" Binding="{Binding UpdatedBy}" Width="100" />
                                <DataGridTextColumn Header="Lý do đổi" Binding="{Binding ChangeReason}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ReportWorkspacePanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Phương thức mới" Style="{StaticResource ReportWorkspaceFilterLabelStyle}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding PaymentMethods}"
                                  SelectedItem="{Binding SelectedPaymentMethod}"
                                  Margin="8,0,16,8"
                                  Style="{StaticResource ReportWorkspaceComboBoxStyle}" />
                        <TextBlock Grid.Row="1" Text="Lý do thay đổi" Style="{StaticResource ReportWorkspaceFilterLabelStyle}" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="3"
                                 Text="{Binding ChangeReason}"
                                 Margin="8,0,16,0"
                                 Height="72"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 Style="{StaticResource ReportWorkspaceTextBoxStyle}" />

                        <Button Grid.RowSpan="2"
                                Grid.Column="4"
                                Content="Cập nhật"
                                Click="ApplyButton_Click"
                                Width="120"
                                Style="{StaticResource ReportWorkspacePrimaryButtonStyle}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Background="#99FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Đang xử lý payment correction..."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#102A43" />
        </Border>
    </Grid>
</UserControl>
