<UserControl x:Class="DineFlow.WPFApp.Features.Reports.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:revenue="clr-namespace:DineFlow.WPFApp.Features.Reports.Revenue"
             xmlns:topselling="clr-namespace:DineFlow.WPFApp.Features.Reports.TopSelling"
             xmlns:payments="clr-namespace:DineFlow.WPFApp.Features.Reports.Payments"
             xmlns:history="clr-namespace:DineFlow.WPFApp.Features.Reports.BillHistory">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Reports/ReportWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Style="{StaticResource ReportWorkspaceRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B55A0" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="OverviewTabButton" Content="Tổng quan" Tag="Active" Style="{StaticResource TopTabButtonStyle}" Click="OpenOverviewTabButton_Click" />
                    <Button x:Name="RevenueTabButton" Content="Doanh thu" Style="{StaticResource TopTabButtonStyle}" Click="OpenRevenueTabButton_Click" />
                    <Button x:Name="TopSellingTabButton" Content="Top bán chạy" Style="{StaticResource TopTabButtonStyle}" Click="OpenTopSellingTabButton_Click" />
                    <Button x:Name="PaymentMethodTabButton" Content="Theo phương thức" Style="{StaticResource TopTabButtonStyle}" Click="OpenPaymentMethodRevenueTabButton_Click" />
                    <Button x:Name="PaidHistoryTabButton" Content="Lịch sử bill paid" Style="{StaticResource TopTabButtonStyle}" Click="OpenPaidBillHistoryTabButton_Click" />
                    <Button x:Name="PaymentCorrectionTabButton" Content="Sửa payment" Style="{StaticResource TopTabButtonStyle}" Click="OpenPaymentCorrectionTabButton_Click" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="{Binding ErrorMessage}"
                           Foreground="#FEE2E2"
                           TextWrapping="Wrap"
                           MaxWidth="520"
                           FontWeight="SemiBold" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid x:Name="OverviewPanel" Visibility="Visible">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Dashboard tổng quan" FontSize="18" FontWeight="Bold" Foreground="#102A43" />
                                <TextBlock Text="{Binding TitleDate, StringFormat=Ngày dữ liệu: {0}}" Foreground="#64748B" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Tải lại"
                                    Click="RefreshButton_Click"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource TableSecondaryButtonStyle}"
                                    MinHeight="34"
                                    Padding="16,0" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <UniformGrid Columns="4" Margin="0,0,0,16">
                                <Border Style="{StaticResource ReportWorkspaceMetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Doanh thu hôm nay" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                                        <TextBlock Text="{Binding RevenueTodayText}" Margin="0,10,0,0" FontSize="24" FontWeight="Bold" Foreground="#102A43" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ReportWorkspaceMetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Bill đã thanh toán" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                                        <TextBlock Text="{Binding PaidBillCountToday}" Margin="0,10,0,0" FontSize="24" FontWeight="Bold" Foreground="#102A43" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ReportWorkspaceMetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Giá trị bill trung bình" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                                        <TextBlock Text="{Binding AverageBillValueText}" Margin="0,10,0,0" FontSize="24" FontWeight="Bold" Foreground="#102A43" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ReportWorkspaceMetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Order hôm nay" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                                        <TextBlock Text="{Binding OrderCountToday}" Margin="0,10,0,0" FontSize="24" FontWeight="Bold" Foreground="#102A43" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ReportWorkspaceMetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Bàn đang phục vụ" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                                        <TextBlock Text="{Binding ServingTableCount}" Margin="0,10,0,0" FontSize="24" FontWeight="Bold" Foreground="#102A43" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ReportWorkspaceMetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Bàn chờ thanh toán" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                                        <TextBlock Text="{Binding WaitingPaymentTableCount}" Margin="0,10,0,0" FontSize="24" FontWeight="Bold" Foreground="#102A43" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ReportWorkspaceMetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Print failed hôm nay" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                                        <TextBlock Text="{Binding PrintFailedOrderCount}" Margin="0,10,0,0" FontSize="24" FontWeight="Bold" Foreground="#102A43" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource ReportWorkspacePanelStyle}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="Top món bán chạy hôm nay" FontSize="18" FontWeight="Bold" Foreground="#102A43" />
                                        <Grid Margin="0,14,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="46" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid Background="#F4F7FA">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Món" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="SL" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="2" Text="Doanh thu" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </Grid>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="260">
                                                <ItemsControl ItemsSource="{Binding TopSellingItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource ManagementListRowStyle}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="80" />
                                                                        <ColumnDefinition Width="140" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding ItemName}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding TotalQuantity}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding TotalRevenue, StringFormat={}{0:N0}}" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource ReportWorkspacePanelStyle}" Margin="12,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Doanh thu theo phương thức" FontSize="18" FontWeight="Bold" Foreground="#102A43" />
                                        <Grid Margin="0,14,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="46" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid Background="#F4F7FA">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Phương thức" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="Lượt" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="2" Text="Tổng tiền" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </Grid>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="260">
                                                <ItemsControl ItemsSource="{Binding RevenueByPaymentMethods}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource ManagementListRowStyle}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="80" />
                                                                        <ColumnDefinition Width="140" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding PaymentMethod}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding PaymentCount}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding TotalAmount, StringFormat={}{0:N0}}" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Background="#99FFFFFF"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Đang tải dashboard..."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#102A43" />
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="RevenuePanel" Visibility="Collapsed">
                <revenue:RevenueReportView />
            </Grid>

            <Grid x:Name="TopSellingPanel" Visibility="Collapsed">
                <topselling:TopSellingItemsReportView />
            </Grid>

            <Grid x:Name="PaymentMethodPanel" Visibility="Collapsed">
                <payments:RevenueByPaymentMethodView />
            </Grid>

            <Grid x:Name="PaidHistoryPanel" Visibility="Collapsed">
                <history:PaidBillHistoryView />
            </Grid>

            <Grid x:Name="PaymentCorrectionPanel" Visibility="Collapsed">
                <payments:PaymentCorrectionView />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
