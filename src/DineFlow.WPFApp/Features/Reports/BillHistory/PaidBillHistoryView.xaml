<UserControl x:Class="DineFlow.WPFApp.Features.Reports.BillHistory.PaidBillHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Reports/ReportWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Style="{StaticResource ReportWorkspaceRootStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource ReportWorkspaceHeaderBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Lịch sử bill đã thanh toán" FontSize="27" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Tra cứu payment record, xem trạng thái chỉnh sửa và mở nhanh sang màn correction."
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource ReportWorkspaceHeaderTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ReportWorkspacePanelStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <StackPanel Width="250" Margin="0,0,16,12">
                                <TextBlock Text="Từ ngày" Style="{StaticResource ReportWorkspaceFilterLabelStyle}" />
                                <DatePicker SelectedDate="{Binding FromDate}" Margin="0,8,0,0" Style="{StaticResource ReportWorkspaceDatePickerStyle}" />
                            </StackPanel>

                            <StackPanel Width="250" Margin="0,0,16,12">
                                <TextBlock Text="Đến ngày" Style="{StaticResource ReportWorkspaceFilterLabelStyle}" />
                                <DatePicker SelectedDate="{Binding ToDate}" Margin="0,8,0,0" Style="{StaticResource ReportWorkspaceDatePickerStyle}" />
                            </StackPanel>

                            <StackPanel Width="220" Margin="0,0,16,12">
                                <TextBlock Text="Phương thức" Style="{StaticResource ReportWorkspaceFilterLabelStyle}" />
                                <ComboBox ItemsSource="{Binding PaymentMethods}"
                                          SelectedItem="{Binding SelectedPaymentMethod}"
                                          Margin="0,8,0,0"
                                          Style="{StaticResource ReportWorkspaceComboBoxStyle}" />
                            </StackPanel>

                            <StackPanel Width="220" Margin="0,0,16,12">
                                <TextBlock Text="Tên bàn" Style="{StaticResource ReportWorkspaceFilterLabelStyle}" />
                                <TextBox Text="{Binding TableName}"
                                         Margin="0,8,0,0"
                                         VerticalContentAlignment="Center"
                                         Style="{StaticResource ReportWorkspaceTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Width="220" Margin="0,0,16,12">
                                <TextBlock Text="Khu vực" Style="{StaticResource ReportWorkspaceFilterLabelStyle}" />
                                <TextBox Text="{Binding Area}"
                                         Margin="0,8,0,0"
                                         VerticalContentAlignment="Center"
                                         Style="{StaticResource ReportWorkspaceTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Width="260" Margin="0,0,16,12">
                                <TextBlock Text="Keyword BillId" Style="{StaticResource ReportWorkspaceFilterLabelStyle}" />
                                <TextBox Text="{Binding Keyword}"
                                         Margin="0,8,0,0"
                                         VerticalContentAlignment="Center"
                                         Style="{StaticResource ReportWorkspaceTextBoxStyle}" />
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Xem lịch sử"
                                    Margin="0,0,8,0"
                                    Click="LoadButton_Click"
                                    Width="120"
                                    Style="{StaticResource ReportWorkspacePrimaryButtonStyle}" />
                            <Button Content="CSV"
                                    Margin="0,0,8,0"
                                    Click="ExportCsvButton_Click"
                                    Width="90"
                                    Style="{StaticResource ReportWorkspaceSecondaryButtonStyle}" />
                            <Button Content="Excel"
                                    Click="ExportExcelButton_Click"
                                    Width="90"
                                    Style="{StaticResource ReportWorkspaceSecondaryButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C53030"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <UniformGrid Columns="2" Margin="0,0,0,16">
                    <Border Style="{StaticResource ReportWorkspaceMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Số payment record" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                            <TextBlock Text="{Binding PaymentCount}" Margin="0,10,0,0" FontSize="24" FontWeight="Bold" Foreground="#102A43" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,0,0" Padding="18" Background="#FFFFFF" CornerRadius="14">
                        <StackPanel>
                            <TextBlock Text="Tổng tiền payment" Style="{StaticResource ReportWorkspaceMutedTextStyle}" />
                            <TextBlock Text="{Binding TotalPaymentAmountText}" Margin="0,10,0,0" FontSize="24" FontWeight="Bold" Foreground="#102A43" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource ReportWorkspacePanelStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Paid bill history theo payment record"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#102A43" />
                                <TextBlock Text="Có thể mở nhanh tab sửa payment từ từng dòng lịch sử."
                                           Margin="0,6,0,0"
                                           Foreground="#627D98" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Sang tab sửa payment"
                                    Width="160"
                                    Click="OpenCorrectionWorkspaceButton_Click"
                                    Style="{StaticResource ReportWorkspaceSecondaryButtonStyle}" />
                        </Grid>
                        <ScrollViewer Margin="0,14,0,0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <Grid MinWidth="1950">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="46" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Background="#F4F7FA">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PaymentId" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="BillId" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="BillCode" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="BillName" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Bàn" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="Khu vực" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="Phương thức" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="7" Text="Tiền payment" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="8" Text="Tổng bill" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="9" Text="PaidAt" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="10" Text="Confirmed by" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="11" Text="Trạng thái" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="12" Text="UpdatedAt" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="13" Text="Updated by" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="14" Text="Lý do đổi" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="15" Text="Thao tác" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="340">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ManagementListRowStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="220" />
                                                            <ColumnDefinition Width="140" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding PaymentId}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding BillId}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding BillCode}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding BillName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4" Text="{Binding TableName}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="5" Text="{Binding Area}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="6" Text="{Binding PaymentMethod}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="7" Text="{Binding PaymentAmountText}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="8" Text="{Binding BillFinalAmountText}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="9" Text="{Binding PaidAtText}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="10" Text="{Binding ConfirmedByName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="11" Text="{Binding CorrectedText}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="12" Text="{Binding UpdatedAtText}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="13" Text="{Binding UpdatedByName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="14" Text="{Binding ChangeReason}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="15"
                                                                Content="Sửa payment"
                                                                Tag="{Binding}"
                                                                Click="OpenPaymentCorrectionButton_Click"
                                                                Style="{StaticResource TableSecondaryButtonStyle}"
                                                                MinHeight="34"
                                                                Padding="14,0" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Background="#99FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Đang tải paid bill history..."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#102A43" />
        </Border>
    </Grid>
</UserControl>
