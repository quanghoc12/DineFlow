<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Management/Tables/TableManagementStyles.xaml" />
        <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Operations/OrderManagement/Styles/OrderManagement.ShellStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="ReportWorkspaceBackgroundBrush" Color="#F4F7FB" />
    <SolidColorBrush x:Key="ReportWorkspaceHeaderBrush" Color="#0B55A0" />
    <SolidColorBrush x:Key="ReportWorkspaceHeaderTextBrush" Color="#CDE4FF" />
    <SolidColorBrush x:Key="ReportWorkspacePanelBorderBrush" Color="#D9E2EC" />
    <SolidColorBrush x:Key="ReportWorkspaceMutedTextBrush" Color="#627D98" />

    <Style x:Key="ReportWorkspaceRootStyle" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource ReportWorkspaceBackgroundBrush}" />
    </Style>

    <Style x:Key="ReportWorkspaceHeaderBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ReportWorkspaceHeaderBrush}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="24,18" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="ReportWorkspacePanelStyle" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="ReportWorkspaceMetricCardStyle" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,0,12,12" />
    </Style>

    <Style x:Key="ReportWorkspaceMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ReportWorkspaceMutedTextBrush}" />
    </Style>

    <Style x:Key="ReportWorkspaceSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#102A43" />
    </Style>

    <Style x:Key="ReportWorkspaceFilterLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#486581" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ReportWorkspaceDatePickerStyle" TargetType="DatePicker">
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Margin" Value="8,0,16,0" />
    </Style>

    <Style x:Key="ReportWorkspaceTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TableFieldStyle}">
        <Setter Property="Margin" Value="8,0,16,0" />
    </Style>

    <Style x:Key="ReportWorkspaceComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource TableComboStyle}">
        <Setter Property="Margin" Value="8,0,16,0" />
    </Style>

    <Style x:Key="ReportWorkspacePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TablePrimaryButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <Style x:Key="ReportWorkspaceSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TableSecondaryButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <Style x:Key="ReportWorkspaceDataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Margin" Value="0,14,0,0" />
        <Setter Property="MinHeight" Value="280" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#EDF2F7" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="White" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#EDF2F7" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
    </Style>
</ResourceDictionary>
