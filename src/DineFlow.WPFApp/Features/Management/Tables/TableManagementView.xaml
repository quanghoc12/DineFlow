<UserControl x:Class="DineFlow.WPFApp.Features.Management.Tables.TableManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Management/Tables/TableManagementStyles.xaml"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#0B55A0" CornerRadius="16" Padding="24,18" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Quản lý khu vực &amp; bàn" FontSize="27" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Sắp xếp khu vực, bàn và quản lý QR gọi món."
                           Margin="0,5,0,0" Foreground="#CDE4FF"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button x:Name="AreaTabButton" Content="Khu vực" Tag="Active"
                    Style="{StaticResource ManagementTabButtonStyle}" Click="AreaTab_Click"/>
            <Button x:Name="TableTabButton" Content="Bàn"
                    Style="{StaticResource ManagementTabButtonStyle}" Click="TableTab_Click"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" CornerRadius="16" Padding="18">
            <Grid>
                <Grid x:Name="AreaPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="+ Thêm khu vực" Click="AddArea_Click"
                                Style="{StaticResource TablePrimaryButtonStyle}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Danh sách khu vực" FontSize="18" FontWeight="Bold" Foreground="#102A43"/>
                            <TextBlock Text="Quản lý thứ tự và trạng thái hoạt động."
                                       Foreground="#829AB1" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1" Background="#F4F7FA" Height="46">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Thứ tự" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334E68"/>
                        <TextBlock Grid.Column="1" Text="Khu vực" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334E68"/>
                        <TextBlock Grid.Column="2" Text="Số bàn" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334E68"/>
                        <TextBlock Grid.Column="3" Text="Trạng thái" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334E68"/>
                        <TextBlock Grid.Column="4" Text="Thao tác" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334E68"/>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ManagedAreas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ManagementListRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="78"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/><ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="198"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayOrder}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AreaName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TableCount}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding ActiveStatusLabel}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Sửa" Tag="{Binding}" Click="EditArea_Click"
                                                        Style="{StaticResource TableSecondaryButtonStyle}"
                                                        MinHeight="34" Padding="14,0" Margin="0,0,7,0"/>
                                                <Button Content="Khóa / Mở" Tag="{Binding}" Click="ToggleArea_Click"
                                                        Style="{StaticResource TableSecondaryButtonStyle}"
                                                        MinHeight="34" Padding="14,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="#C53030"
                               VerticalAlignment="Bottom" Margin="12"/>
                </Grid>

                <Grid x:Name="TablePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/><ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TableFieldStyle}" ToolTip="Tìm tên bàn hoặc khu vực"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Areas}" SelectedItem="{Binding AreaFilter}"
                                  Margin="10,0,0,0" Style="{StaticResource TableComboStyle}" ToolTip="Lọc khu vực"/>
                        <TextBlock Grid.Column="2" Text="{Binding ErrorMessage}" Foreground="#C53030"
                                   VerticalAlignment="Center" Margin="14,0"/>
                        <Button Grid.Column="3" Content="+ Thêm bàn" Click="CreateButton_Click"
                                Style="{StaticResource TablePrimaryButtonStyle}"/>
                    </Grid>
                    <Grid Grid.Row="1" Background="#F4F7FA" Height="46">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="140"/><ColumnDefinition Width="120"/><ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tên bàn" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334E68"/>
                        <TextBlock Grid.Column="1" Text="Khu vực" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334E68"/>
                        <TextBlock Grid.Column="2" Text="Thứ tự" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334E68"/>
                        <TextBlock Grid.Column="3" Text="Trạng thái" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334E68"/>
                        <TextBlock Grid.Column="4" Text="Hoạt động" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334E68"/>
                        <TextBlock Grid.Column="5" Text="Thao tác" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334E68"/>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Tables}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ManagementListRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/>
                                                <ColumnDefinition Width="140"/><ColumnDefinition Width="120"/><ColumnDefinition Width="158"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TableName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Area}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayOrder}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding StatusLabel}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding ActiveStatusLabel}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Xem QR" Tag="{Binding}" Click="PreviewQrRow_Click"
                                                        Style="{StaticResource TableSecondaryButtonStyle}"
                                                        MinHeight="34" Padding="12,0" Margin="0,0,7,0"/>
                                                <Button Content="Sửa" Tag="{Binding}" Click="EditTableRow_Click"
                                                        Style="{StaticResource TableSecondaryButtonStyle}"
                                                        MinHeight="34" Padding="14,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
