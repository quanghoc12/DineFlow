<UserControl x:Class="DineFlow.WPFApp.Features.Management.Tables.TableManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Quản lý bàn &amp; QR"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#102A43" />
                <TextBlock Text="Quản lý khu vực, trạng thái hoạt động và mã QR gọi món."
                           Margin="0,6,0,0"
                           Foreground="#627D98" />
            </StackPanel>
            <Button Content="+ Thêm bàn"
                    Click="CreateButton_Click"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Padding="16,10"
                    Background="#2F80ED"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold" />
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="10,10,0,0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,7"
                         ToolTip="Tìm tên bàn hoặc khu vực" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Areas}"
                          SelectedItem="{Binding AreaFilter}"
                          Margin="10,0,0,0"
                          Padding="8,6"
                          ToolTip="Lọc khu vực" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ErrorMessage}"
                           Foreground="#C53030"
                           VerticalAlignment="Center"
                           Margin="14,0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="Sửa" Click="EditButton_Click" Padding="12,7" Margin="0,0,7,0" />
                    <Button Content="Xem QR" Click="PreviewQrButton_Click" Padding="12,7" Margin="0,0,7,0" />
                    <Button Content="Copy URL" Click="CopyUrlButton_Click" Padding="12,7" Margin="0,0,7,0" />
                    <Button Content="Tạo lại QR" Click="ResetQrButton_Click" Padding="12,7" Margin="0,0,7,0" />
                    <Button Content="Khóa / Mở" Click="ToggleActiveButton_Click" Padding="12,7" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="0,0,10,10">
            <DataGrid ItemsSource="{Binding Tables}"
                      SelectedItem="{Binding SelectedTable}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên bàn" Binding="{Binding TableName}" Width="*" />
                    <DataGridTextColumn Header="Khu vực" Binding="{Binding Area}" Width="*" />
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="140" />
                    <DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding IsActive}" Width="100" />
                    <DataGridTextColumn Header="QR Token" Binding="{Binding QrToken}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
