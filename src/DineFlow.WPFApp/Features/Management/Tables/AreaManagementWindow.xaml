<Window x:Class="DineFlow.WPFApp.Features.Management.Tables.AreaManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý khu vực" Width="620" Height="460" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
        <ListBox x:Name="AreaList" DisplayMemberPath="AreaName" SelectionChanged="AreaList_SelectionChanged"/>
        <StackPanel Grid.Column="1" Margin="18,0,0,0">
            <TextBlock Text="Tên khu vực"/><TextBox x:Name="AreaNameBox" Margin="0,4,0,10"/>
            <TextBlock Text="Thứ tự hiển thị"/><TextBox x:Name="DisplayOrderBox" Text="0" Margin="0,4,0,12"/>
            <WrapPanel>
                <Button Content="Tạo mới" Click="New_Click" Padding="14,7" Margin="0,0,8,0"/>
                <Button Content="Lưu" Click="Save_Click" Padding="14,7" Margin="0,0,8,0"/>
                <Button Content="Khóa / Mở" Click="Toggle_Click" Padding="14,7"/>
            </WrapPanel>
            <TextBlock x:Name="StatusText" Margin="0,16,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
