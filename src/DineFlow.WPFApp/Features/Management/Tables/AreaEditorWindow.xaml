<Window x:Class="DineFlow.WPFApp.Features.Management.Tables.AreaEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Khu vực" Width="620" Height="470" MinWidth="620" MinHeight="470"
        Background="#EEF3F8" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Management/Tables/TableManagementStyles.xaml"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="82"/>
        </Grid.RowDefinitions>
        <Border Background="#0B55A0" Padding="28,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeadingText" Text="Thêm khu vực" Foreground="White"
                           FontSize="25" FontWeight="Bold"/>
                <TextBlock Text="Thiết lập tên và vị trí hiển thị của khu vực."
                           Foreground="#CDE4FF" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Margin="24" Padding="26,18" Background="White" CornerRadius="16">
            <StackPanel>
                <TextBlock Text="Tên khu vực" Style="{StaticResource TableDialogLabelStyle}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource TableFieldStyle}"/>
                <TextBlock Text="Thứ tự hiển thị" Style="{StaticResource TableDialogLabelStyle}"/>
                <TextBox x:Name="OrderBox" Text="0" Style="{StaticResource TableFieldStyle}"/>
                <TextBlock Text="Khi đổi thứ tự, các khu vực còn lại sẽ tự động được sắp xếp lại."
                           Foreground="#829AB1" Margin="0,9,0,0"/>
                <TextBlock x:Name="ErrorText" Foreground="#C53030" Margin="0,12,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE5EE" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="24,0">
                <Button Content="Hủy" IsCancel="True" Style="{StaticResource TableSecondaryButtonStyle}"
                        MinWidth="110" Margin="0,0,10,0"/>
                <Button Content="Lưu khu vực" Click="Save_Click"
                        Style="{StaticResource TablePrimaryButtonStyle}" MinWidth="145"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
