<Window x:Class="DineFlow.WPFApp.Features.Management.Tables.TableEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin bàn"
        Width="400"
        Height="310"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="28">
        <TextBlock x:Name="HeadingText" Text="Thêm bàn" FontSize="24" FontWeight="Bold" />
        <TextBlock Text="Tên bàn" Margin="0,24,0,7" FontWeight="SemiBold" />
        <TextBox x:Name="TableNameTextBox" Padding="9,6" />
        <TextBlock Text="Khu vực" Margin="0,14,0,7" FontWeight="SemiBold" />
        <TextBox x:Name="AreaTextBox" Padding="9,6" />
        <TextBlock x:Name="ErrorText" Foreground="#C53030" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Hủy" Click="CancelButton_Click" Padding="15,7" Margin="0,0,8,0" />
            <Button Content="Lưu" Click="SaveButton_Click" Padding="15,7" />
        </StackPanel>
    </StackPanel>
</Window>
