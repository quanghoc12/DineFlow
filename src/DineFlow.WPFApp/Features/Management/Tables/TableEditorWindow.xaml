<Window x:Class="DineFlow.WPFApp.Features.Management.Tables.TableEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin bàn" Width="860" Height="680" MinWidth="760" MinHeight="620"
        Background="#EEF3F8" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Management/Tables/TableManagementStyles.xaml"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="88"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="84"/>
        </Grid.RowDefinitions>
        <Border Background="#0B55A0" Padding="30,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeadingText" Text="Thêm bàn" Foreground="White"
                           FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Thiết lập khu vực, thứ tự và mã QR gọi món."
                           Foreground="#CDE4FF" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Padding="26,16" Background="White" CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="Thông tin bàn" FontSize="18" FontWeight="Bold" Foreground="#102A43"/>
                    <TextBlock Text="Khu vực" Style="{StaticResource TableDialogLabelStyle}"/>
                    <ComboBox x:Name="AreaComboBox" DisplayMemberPath="AreaName"
                              Style="{StaticResource TableComboStyle}"/>
                    <TextBlock Text="Tên bàn" Style="{StaticResource TableDialogLabelStyle}"/>
                    <TextBox x:Name="TableNameTextBox" Style="{StaticResource TableFieldStyle}"/>
                    <TextBlock Text="Thứ tự trong khu vực" Style="{StaticResource TableDialogLabelStyle}"/>
                    <TextBox x:Name="OrderTextBox" Text="0" Style="{StaticResource TableFieldStyle}"/>
                    <TextBlock Text="Các bàn cùng khu vực sẽ tự động được đánh lại thứ tự."
                               Foreground="#829AB1" Margin="0,9,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border x:Name="QrActions" Grid.Column="2" Padding="26,16" Background="White"
                    CornerRadius="16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="QR và trạng thái" FontSize="18" FontWeight="Bold" Foreground="#102A43"/>
                    <TextBlock Text="Mã QR gọi món" Style="{StaticResource TableDialogLabelStyle}"/>
                    <Button Content="Xem mã QR" Click="PreviewQr_Click"
                            Style="{StaticResource TableSecondaryButtonStyle}" HorizontalAlignment="Left"/>
                    <TextBlock Text="URL gọi món" Style="{StaticResource TableDialogLabelStyle}"/>
                    <TextBox x:Name="UrlTextBox" IsReadOnly="True" Style="{StaticResource TableFieldStyle}"/>
                    <Button Content="Copy URL" Click="CopyUrl_Click"
                            Style="{StaticResource TableSecondaryButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    <Separator Margin="0,20,0,12"/>
                    <WrapPanel>
                        <Button Content="Tạo lại QR" Click="ResetQr_Click"
                                Style="{StaticResource TableSecondaryButtonStyle}" Margin="0,0,10,8"/>
                        <Button x:Name="ToggleButton" Content="Khóa bàn" Click="ToggleActive_Click"
                                Style="{StaticResource TableDangerButtonStyle}" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock Text="Không thể khóa hoặc tạo lại QR khi bàn đang phục vụ."
                               Foreground="#829AB1" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border x:Name="CreateHint" Grid.Column="2" Padding="28" Background="White" CornerRadius="16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="54"
                               Foreground="#91C3FF" HorizontalAlignment="Center"/>
                    <TextBlock Text="QR sẽ được tạo tự động" FontSize="18" FontWeight="Bold"
                               Foreground="#102A43" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock Text="Sau khi lưu bàn mới, hệ thống tự sinh URL và mã QR gọi món riêng cho bàn."
                               Foreground="#627D98" TextAlignment="Center" TextWrapping="Wrap" Margin="0,9,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="ErrorText" Grid.ColumnSpan="3" Foreground="#C53030"
                       VerticalAlignment="Bottom" Margin="2,0,2,8" TextWrapping="Wrap"/>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDE5EE" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="24,0">
                <Button Content="Hủy" IsCancel="True" Style="{StaticResource TableSecondaryButtonStyle}"
                        MinWidth="110" Margin="0,0,10,0"/>
                <Button Content="Lưu bàn" Click="SaveButton_Click"
                        Style="{StaticResource TablePrimaryButtonStyle}" MinWidth="135"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
