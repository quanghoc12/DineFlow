<Window x:Class="DineFlow.WPFApp.Features.Management.Menu.SalesChannelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kênh bán hàng" Width="640" Height="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize">
    <Border Background="White" BorderBrush="#0866E5" BorderThickness="2" CornerRadius="16" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="HeadingText" Text="Thêm kênh bán mới" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="Cấu hình mã kênh và tên kênh bán hàng (Grab, ShopeeFood...)."
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,16,0,16">
                <TextBlock Text="Mã kênh bán" Margin="0,0,0,6" FontWeight="SemiBold" />
                <TextBox x:Name="CodeTextBox" Padding="9,6" />

                <TextBlock Text="Tên kênh bán" Margin="0,12,0,6" FontWeight="SemiBold" />
                <TextBox x:Name="NameTextBox" Padding="9,6" />
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="ErrorText" Foreground="#C53030" TextWrapping="Wrap" Margin="0,0,0,10" Height="Auto" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="DeleteButton" Content="Xóa kênh" Click="DeleteButton_Click" Background="#EF4444" Foreground="White" Padding="12,7" Margin="0,0,8,0" Visibility="Collapsed" />
                        <Button x:Name="ToggleButton" Content="Ẩn / hiện" Click="ToggleButton_Click" Padding="12,7" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy" Click="CancelButton_Click" Padding="15,7" Margin="0,0,8,0" />
                        <Button Content="Lưu kênh" Click="SaveButton_Click" Padding="15,7" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
