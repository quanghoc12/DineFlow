<Window x:Class="DineFlow.WPFApp.Features.Management.Menu.CategoryManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Danh mục món" Width="650" Height="440" WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <ListBox x:Name="CategoryList" DisplayMemberPath="CategoryName" SelectionChanged="CategoryList_SelectionChanged" />
        <StackPanel Grid.Column="1" Margin="18,0,0,0">
            <TextBlock Text="Tên danh mục" FontWeight="SemiBold" />
            <TextBox x:Name="NameTextBox" Margin="0,6,0,12" Padding="8,5" />
            <TextBlock Text="Mô tả" FontWeight="SemiBold" />
            <TextBox x:Name="DescriptionTextBox" Margin="0,6,0,12" Height="70" TextWrapping="Wrap" />
            <TextBlock Text="Thứ tự" FontWeight="SemiBold" />
            <TextBox x:Name="OrderTextBox" Margin="0,6,0,12" Padding="8,5" Text="0" />
            <TextBlock x:Name="ErrorText" Foreground="#C53030" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Mới" Click="NewButton_Click" Padding="12,7" Margin="0,0,7,0" />
                <Button Content="Lưu" Click="SaveButton_Click" Padding="12,7" Margin="0,0,7,0" />
                <Button Content="Ẩn / Hiện" Click="ToggleButton_Click" Padding="12,7" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
