<Window x:Class="DineFlow.WPFApp.Features.Management.Menu.MenuItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Món ăn" Width="980" Height="820"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize">
    <Border Background="White" BorderBrush="#0866E5" BorderThickness="2" CornerRadius="16" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText" Text="Thêm món" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Thiết lập thông tin món, ảnh, giá, tồn kho và nhóm phụ dùng khi khách đặt món."
                       Foreground="#64748B"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="Danh mục" Margin="0,0,0,6" FontWeight="SemiBold" />
                    <ComboBox x:Name="CategoryComboBox" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId" Padding="8,6" />

                    <TextBlock Text="Tên món" Margin="0,13,0,6" FontWeight="SemiBold" />
                    <TextBox x:Name="NameTextBox" Padding="9,6" />

                    <TextBlock Text="Ảnh" Margin="0,13,0,6" FontWeight="SemiBold" />
                    <DockPanel>
                        <Button Content="Tải ảnh" DockPanel.Dock="Right" Click="PickImageButton_Click" Padding="12,6" Margin="8,0,0,0" />
                        <TextBox x:Name="ImageTextBox" Padding="9,6" />
                    </DockPanel>

                    <TextBlock Text="Giá bán" Margin="0,13,0,6" FontWeight="SemiBold" />
                    <TextBox x:Name="PriceTextBox" Padding="9,6" />

                    <CheckBox x:Name="TrackStockCheckBox"
                              Content="Track tồn kho"
                              Margin="0,14,0,0"
                              Checked="TrackStockCheckBox_Changed"
                              Unchecked="TrackStockCheckBox_Changed" />
                    <TextBlock Text="Tồn kho" Margin="0,10,0,6" FontWeight="SemiBold" />
                    <TextBox x:Name="StockTextBox" Padding="9,6" />

                    <TextBlock Text="Mô tả" Margin="0,13,0,6" FontWeight="SemiBold" />
                    <TextBox x:Name="DescriptionTextBox" Height="82" Padding="9,6" TextWrapping="Wrap" AcceptsReturn="True" />

                    <CheckBox x:Name="AvailableCheckBox"
                              Content="Hoạt động: hiển thị trên menu khách"
                              IsChecked="True"
                              Margin="0,14,0,0" />

                    <WrapPanel x:Name="EditActionPanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <Button x:Name="ToggleActivityButton" Content="Tạm ngưng bán" Click="ToggleActivityButton_Click" Padding="12,7" Margin="0,0,8,0" />
                        <Button x:Name="ToggleOutOfStockButton" Content="Hết món" Click="ToggleOutOfStockButton_Click" Padding="12,7" Margin="0,0,8,0" />
                        <Button Content="Xóa" Click="DeleteButton_Click" Padding="12,7" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock Text="Nhóm phụ của món" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Content="+ Tạo nhóm mới"
                            Click="CreateChoiceGroupButton_Click"
                            DockPanel.Dock="Right"
                            Padding="10,5"
                            FontSize="12"
                            HorizontalAlignment="Right"
                            ToolTip="Tạo nhóm phụ mới ngay tại đây và thêm vào món" />
                </DockPanel>

                <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,8,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Chọn nhóm có sẵn" />
                        <TextBlock Grid.Column="1" Text="MaxSelect"
                                   ToolTip="Loại: luôn = 1. Lựa chọn: mặc định là MaxSelectDefault, có thể chỉnh."
                                   Margin="8,0,0,0" />
                        <TextBlock Grid.Column="2" Text="Thứ tự" Margin="8,0,0,0" />

                        <ComboBox Grid.Row="1" x:Name="ChoiceGroupComboBox"
                                  DisplayMemberPath="GroupName"
                                  SelectionChanged="ChoiceGroupComboBox_SelectionChanged"
                                  Padding="8,6"
                                  Margin="0,5,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="AssignMaxTextBox" Padding="8,6" Margin="8,5,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="2" x:Name="AssignOrderTextBox" Text="0" Padding="8,6" Margin="8,5,0,0" />
                        <Button Grid.Row="2" Grid.ColumnSpan="3" x:Name="AddOrUpdateAssignmentButton" Content="Thêm nhóm"
                                Click="AddOrUpdateAssignment_Click"
                                HorizontalAlignment="Left"
                                Padding="13,7"
                                Margin="0,12,0,0" />
                    </Grid>
                </Border>

                <DataGrid Grid.Row="2" x:Name="AssignedGroupsGrid"
                          ItemsSource="{Binding Assignments, RelativeSource={RelativeSource AncestorType=Window}}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nhóm" Binding="{Binding GroupName}" Width="*" />
                        <DataGridTextColumn Header="Nhóm loại" Binding="{Binding GroupKindLabel}" Width="92" />
                        <DataGridTextColumn Header="Max" Binding="{Binding EffectiveMaxSelect}" Width="70" />
                        <DataGridTextColumn Header="Thứ tự" Binding="{Binding DisplayOrder}" Width="70" />
                        <DataGridTemplateColumn Header="Thao tác" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <WrapPanel>
                                        <Button Content="Sửa" Tag="{Binding}" Click="EditAssignment_Click" Padding="8,4" Margin="0,0,6,0" />
                                        <Button Content="Bỏ" Tag="{Binding}" Click="RemoveAssignment_Click" Padding="8,4" />
                                    </WrapPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock x:Name="ErrorText" Foreground="#C53030" TextWrapping="Wrap" Margin="0,0,0,10" Height="Auto" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy" Click="CancelButton_Click" Padding="15,7" Margin="0,0,8,0" />
                    <Button Content="Lưu món" Click="SaveButton_Click" Padding="15,7" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
