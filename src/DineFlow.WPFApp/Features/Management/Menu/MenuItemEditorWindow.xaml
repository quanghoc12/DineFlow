<Window x:Class="DineFlow.WPFApp.Features.Management.Menu.MenuItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Món ăn" Width="470" Height="620" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock x:Name="HeadingText" Text="Thêm món" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Tên món" Margin="0,20,0,6" FontWeight="SemiBold" />
            <TextBox x:Name="NameTextBox" Padding="9,6" />
            <TextBlock Text="Danh mục" Margin="0,13,0,6" FontWeight="SemiBold" />
            <ComboBox x:Name="CategoryComboBox" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId" Padding="8,6" />
            <TextBlock Text="Giá bán" Margin="0,13,0,6" FontWeight="SemiBold" />
            <TextBox x:Name="PriceTextBox" Padding="9,6" />
            <TextBlock Text="Tồn kho (để trống nếu không theo dõi)" Margin="0,13,0,6" FontWeight="SemiBold" />
            <TextBox x:Name="StockTextBox" Padding="9,6" />
            <TextBlock Text="URL ảnh" Margin="0,13,0,6" FontWeight="SemiBold" />
            <TextBox x:Name="ImageTextBox" Padding="9,6" />
            <TextBlock Text="Mô tả" Margin="0,13,0,6" FontWeight="SemiBold" />
            <TextBox x:Name="DescriptionTextBox" Height="70" Padding="9,6" TextWrapping="Wrap" AcceptsReturn="True" />
            <CheckBox x:Name="AvailableCheckBox" Content="Đang mở bán" IsChecked="True" Margin="0,14,0,0" />
            <TextBlock x:Name="ErrorText" Foreground="#C53030" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Hủy" Click="CancelButton_Click" Padding="15,7" Margin="0,0,8,0" />
                <Button Content="Lưu" Click="SaveButton_Click" Padding="15,7" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
