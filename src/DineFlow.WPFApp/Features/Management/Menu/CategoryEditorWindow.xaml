<Window x:Class="DineFlow.WPFApp.Features.Management.Menu.CategoryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Danh mục món ăn" Width="580" Height="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize">
    <Border Background="White" BorderBrush="#0866E5" BorderThickness="2" CornerRadius="16" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="HeadingText" Text="Thêm danh mục mới" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Nhập tên, mô tả và thứ tự sắp xếp của danh mục thực đơn."
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,16,0,16" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Tên danh mục" Margin="0,0,0,6" FontWeight="SemiBold" />
                    <TextBox x:Name="NameTextBox" Padding="9,6" />

                    <TextBlock Text="Mô tả" Margin="0,13,0,6" FontWeight="SemiBold" />
                    <TextBox x:Name="DescriptionTextBox" Height="70" Padding="9,6" TextWrapping="Wrap" AcceptsReturn="True" />

                    <Grid Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <CheckBox x:Name="IsActiveCheckBox"
                                      Content="Hoạt động: hiển thị trên menu"
                                      IsChecked="True"
                                      VerticalAlignment="Center"
                                      Margin="0,10,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Thứ tự hiển thị" Margin="0,0,0,6" FontWeight="SemiBold" />
                            <TextBox x:Name="OrderTextBox" Text="0" Padding="9,6" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="ErrorText" Foreground="#C53030" TextWrapping="Wrap" Margin="0,0,0,10" Height="Auto" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="DeleteButton" Content="Xóa" Click="DeleteButton_Click" Background="#C53030" Foreground="White" BorderThickness="0" Padding="15,7" Visibility="Collapsed" HorizontalAlignment="Left" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy" Click="CancelButton_Click" Padding="15,7" Margin="0,0,8,0" />
                        <Button Content="Lưu danh mục" Click="SaveButton_Click" Padding="15,7" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
