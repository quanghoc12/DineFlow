<UserControl x:Class="DineFlow.WPFApp.Features.Management.Menu.MenuManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DineFlow.WPFApp.Features.Management.Menu">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Operations/OrderManagement/Styles/OrderManagement.ShellStyles.xaml" />
                <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Management/Tables/TableManagementStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:ChannelPriceConverter x:Key="ChannelPriceConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F4F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Tab Bar styled exactly like Order Management -->
        <Border Grid.Row="0" Background="#0B55A0" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CategoryTabButton"
                            Content="Danh mục"
                            Tag="Active"
                            Style="{StaticResource TopTabButtonStyle}"
                            Click="CategoryTabButton_Click" />
                    <Button x:Name="MenuItemTabButton"
                            Content="Thực đơn"
                            Style="{StaticResource TopTabButtonStyle}"
                            Click="MenuItemTabButton_Click" />
                    <Button x:Name="ChoiceGroupTabButton"
                            Content="Nhóm phụ"
                            Style="{StaticResource TopTabButtonStyle}"
                            Click="ChoiceGroupTabButton_Click" />
                    <Button x:Name="SalesChannelTabButton"
                            Content="Kênh bán"
                            Style="{StaticResource TopTabButtonStyle}"
                            Click="SalesChannelTabButton_Click" />
                </StackPanel>

                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding ErrorMessage}" Foreground="#FEE2E2" TextWrapping="Wrap" MaxWidth="520" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="16">
            <Grid x:Name="CategoryPanel" Visibility="Visible">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Danh sách danh mục hiện tại" FontSize="18" FontWeight="Bold" Foreground="#102A43" />
                                <TextBlock Text="Bấm Sửa trên từng dòng để điều chỉnh thông tin danh mục." Foreground="#64748B" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Content="+ Thêm danh mục"
                                    Click="AddCategoryButton_Click"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="#2F80ED"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="16,9" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Background="#F4F7FA">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Thứ tự" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Tên danh mục" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Mô tả" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Hoạt động" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Thao tác" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding EditableCategories}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Style="{StaticResource ManagementListRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="78"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.5*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="118"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayOrder}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CategoryName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <CheckBox Grid.Column="3" IsChecked="{Binding IsActive}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                            <Button Grid.Column="4" Content="Sửa" Tag="{Binding}" Click="EditCategoryRow_Click"
                                                    Style="{StaticResource TableSecondaryButtonStyle}" MinHeight="34" Padding="16,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="MenuItemPanel" Visibility="Collapsed">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm món" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" DisplayMemberPath="CategoryName"
                                      SelectedItem="{Binding CategoryFilter}" Margin="10,0,0,0" />
                            <TextBlock Grid.Column="2" Text="Thêm/sửa món bằng dialog riêng. Hết món vẫn có thể hiển thị trên menu khách." VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#64748B" />
                            <Button Grid.Column="3" Content="+ Thêm món" Click="AddMenuItemButton_Click" Padding="14,8" Margin="12,0,0,0" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Background="#F4F7FA">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ảnh" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Tên món" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Danh mục" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Giá" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Tồn" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="5" Text="Trạng thái" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="6" Text="Thao tác" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Style="{StaticResource ManagementListRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="78"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" CornerRadius="8" ClipToBounds="True" Background="#F1F5F9" HorizontalAlignment="Left">
                                                <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CategoryName}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding BasePrice, StringFormat={}{0:N0} ₫}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding StockStatusLabel}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding VisibilityStatusLabel}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="6" Content="Sửa" Tag="{Binding}" Click="EditMenuItemRow_Click"
                                                    Style="{StaticResource TableSecondaryButtonStyle}" MinHeight="34" Padding="14,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="ChoiceGroupPanel" Visibility="Collapsed">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,12" LastChildFill="False">
                        <StackPanel>
                            <TextBlock Text="Nhóm phụ" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="Nhóm Loại dùng cho các lựa chọn phải chọn đúng 1 như size, đá. Nhóm Lựa chọn dùng cho topping/add-on, cho chọn nhiều theo MaxSelect."
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Content="+ Thêm nhóm" Click="AddChoiceGroupButton_Click" DockPanel.Dock="Right"
                                HorizontalAlignment="Right" Padding="14,8" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Background="#F4F7FA">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/><ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Nhóm phụ" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Nhóm" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Max mặc định" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Hoạt động" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Thao tác" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ChoiceGroups}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Style="{StaticResource ManagementListRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="120"/><ColumnDefinition Width="88"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding GroupName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding GroupKindLabel}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding MaxSelectDefault}" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="3" IsChecked="{Binding IsAvailable}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                            <Button Grid.Column="4" Content="Sửa" Tag="{Binding}" Click="EditChoiceGroupRow_Click"
                                                    Style="{StaticResource TableSecondaryButtonStyle}" MinHeight="34" Padding="14,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>

            <Grid x:Name="SalesChannelPanel" Visibility="Collapsed">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left side: List of channels -->
                    <Grid Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Content="+ Thêm kênh bán" Click="AddChannelButton_Click" Margin="0,0,0,12" Padding="14,8" HorizontalAlignment="Stretch" />

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Background="#F4F7FA">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="82"/><ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mã kênh" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="Tên kênh" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="Hoạt động" Margin="6,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="Thao tác" Margin="6,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SalesChannels}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Style="{StaticResource ManagementListRowStyle}" MouseLeftButtonUp="SalesChannelRow_Click" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="82"/><ColumnDefinition Width="58"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ChannelCode}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ChannelName}" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="2" IsChecked="{Binding IsActive}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Content="Sửa" Tag="{Binding}" Click="EditChannelRow_Click"
                                                        Style="{StaticResource TableSecondaryButtonStyle}" MinHeight="34" Padding="10,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- Right side: Channel Pricing configuration -->
                    <Grid Grid.Column="1">
                        <!-- Case 1: No channel selected -->
                        <Border x:Name="SelectChannelNotice" Background="#F8FAFC" CornerRadius="10" Padding="24" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Chưa chọn kênh bán" FontSize="18" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" />
                                <TextBlock Text="Vui lòng chọn một kênh bán hàng ở danh sách bên trái để thiết lập giá bán." Margin="0,8,0,0" Foreground="#94A3B8" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Case 2: Default "Tại quán" channel selected -->
                        <Border x:Name="DefaultChannelNotice" Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="10" Padding="24" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Kênh bán tại quán (Mặc định)" FontSize="18" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center" />
                                <TextBlock Text="Kênh bán tại quán sử dụng giá gốc mặc định của món ăn và lựa chọn phụ. Không cấu hình giá phụ thu tại đây." Margin="0,8,0,0" Foreground="#166534" TextAlignment="Center" Width="360" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Case 3: Other channels (Pricing TabControl) -->
                        <Grid x:Name="ChannelPricingTabs" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Đang cấu hình giá cho kênh: " FontSize="14" Foreground="#1E3A8A" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedSalesChannel.ChannelName}" FontWeight="Bold" FontSize="15" Foreground="#1E3A8A" VerticalAlignment="Center" />
                                    <TextBlock Text=" (" FontSize="14" Foreground="#1E3A8A" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedSalesChannel.ChannelCode}" FontWeight="Bold" FontSize="14" Foreground="#1E3A8A" VerticalAlignment="Center" />
                                    <TextBlock Text=")" FontSize="14" Foreground="#1E3A8A" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <TabControl Grid.Row="1">
                            <!-- Tab Thực đơn -->
                            <TabItem Header="Thực đơn">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm món" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" DisplayMemberPath="CategoryName"
                                                      SelectedItem="{Binding CategoryFilter}" Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1">
                                        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid Background="#F4F7FA">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="65"/><ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="110"/><ColumnDefinition Width="140"/><ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Danh mục" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="Ảnh" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="Tên món" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="3" Text="Giá gốc" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="4" Text="Giá thêm kênh" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="5" Text="Thao tác" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </Grid>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Border Style="{StaticResource ManagementListRowStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="65"/><ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="110"/><ColumnDefinition Width="140"/><ColumnDefinition Width="78"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding CategoryName}" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="7" ClipToBounds="True" Background="#F1F5F9">
                                                                <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding BasePrice, StringFormat={}{0:N0} ₫}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" VerticalAlignment="Center">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{StaticResource ChannelPriceConverter}">
                                                                        <Binding Path="ChannelPrices"/>
                                                                        <Binding Path="DataContext.SelectedSalesChannel" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                            <Button Grid.Column="5" Content="Sửa" Click="EditMenuItemChannelPrice_Click" Tag="{Binding}"
                                                                    Style="{StaticResource TableSecondaryButtonStyle}" MinHeight="34" Padding="12,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <!-- Tab Nhóm phụ -->
                            <TabItem Header="Nhóm phụ">
                                <Grid Margin="12">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid Background="#F4F7FA">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Loại nhóm" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="Tên nhóm" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="Thao tác" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </Grid>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ChoiceGroups}">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Border Style="{StaticResource ManagementListRowStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding GroupKindLabel}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding GroupName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                            <Button Grid.Column="2" Content="Chỉnh sửa" Click="EditChoiceGroupChannelPrices_Click" Tag="{Binding}"
                                                                    Style="{StaticResource TableSecondaryButtonStyle}" MinHeight="34" Padding="12,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
