<Window x:Class="DineFlow.WPFApp.Features.Management.Menu.ChoiceGroupChannelPricesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DineFlow.WPFApp.Features.Management.Menu"
        Title="Giá nhóm phụ theo kênh bán" Width="800" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize">
    <Window.Resources>
        <local:ChannelPriceConverter x:Key="ChannelPriceConverter" />
    </Window.Resources>
    <Border Background="White" BorderBrush="#0866E5" BorderThickness="2" CornerRadius="16" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Nhóm phụ: Size" FontSize="18" FontWeight="Bold" />
                <TextBlock x:Name="SubtitleText" Text="Cấu hình giá phụ thu cho các lựa chọn trên kênh bán GrabFood."
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>

            <DataGrid Grid.Row="1" x:Name="ChoiceItemsGrid"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      Margin="0,16,0,16">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên lựa chọn" Binding="{Binding ChoiceName}" Width="*" />
                    <DataGridTextColumn Header="Giá gốc" Binding="{Binding ExtraPrice, StringFormat={}{0:N0} ₫}" Width="120" />
                    <DataGridTemplateColumn Header="Giá thêm kênh bán" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ChannelPriceConverter}">
                                            <Binding Path="ChannelPrices" />
                                            <Binding Path="SelectedChannel" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Thao tác" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Sửa" Click="EditChoicePriceRow_Click" Tag="{Binding}" Padding="10,4" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="ErrorText" Foreground="#C53030" TextWrapping="Wrap" Margin="0,0,0,10" Height="Auto" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Đóng" Click="CloseButton_Click" Padding="18,8" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
