<Window x:Class="DineFlow.WPFApp.Features.Management.Menu.ChoicePricingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lựa chọn và giá theo kênh" Width="920" Height="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="ItemTitle" FontSize="24" FontWeight="Bold"/>
        <TabControl Grid.Row="1" Margin="0,16,0,12">
            <TabItem Header="Nhóm lựa chọn">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="GroupList" DisplayMemberPath="GroupName" SelectionChanged="GroupList_SelectionChanged"/>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="Tên nhóm"/><TextBox x:Name="GroupNameBox" Margin="0,4,0,8"/>
                        <CheckBox x:Name="RequiredBox" Content="Bắt buộc chọn đúng 1" Margin="0,0,0,8"/>
                        <TextBlock Text="Số lựa chọn tối đa"/><TextBox x:Name="MaxSelectBox" Text="1" Margin="0,4,0,8"/>
                        <WrapPanel>
                            <Button Content="Tạo nhóm" Click="NewGroup_Click" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="Lưu nhóm" Click="SaveGroup_Click" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="Khóa / Mở nhóm" Click="ToggleGroup_Click" Padding="12,6"/>
                        </WrapPanel>
                        <Separator Margin="0,16"/>
                        <TextBlock Text="Lựa chọn trong nhóm" FontWeight="Bold"/>
                        <ListBox x:Name="ChoiceList" DisplayMemberPath="ChoiceName" Height="130"
                                 SelectionChanged="ChoiceList_SelectionChanged" Margin="0,6,0,8"/>
                        <TextBox x:Name="ChoiceNameBox" ToolTip="Tên lựa chọn" Margin="0,0,0,6"/>
                        <TextBox x:Name="ExtraPriceBox" ToolTip="Giá cộng thêm" Text="0" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="Thêm lựa chọn" Click="NewChoice_Click" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="Lưu lựa chọn" Click="SaveChoice_Click" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="Khóa / Mở" Click="ToggleChoice_Click" Padding="12,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Gán vào món">
                <StackPanel Margin="16">
                    <TextBlock Text="Nhóm lựa chọn"/><ComboBox x:Name="AssignGroupBox" DisplayMemberPath="GroupName" Margin="0,4,0,10"/>
                    <TextBlock Text="Thứ tự hiển thị"/><TextBox x:Name="DisplayOrderBox" Text="0" Margin="0,4,0,10"/>
                    <TextBlock Text="MaxSelect riêng (để trống dùng mặc định)"/><TextBox x:Name="OverrideMaxBox" Margin="0,4,0,12"/>
                    <WrapPanel>
                        <Button Content="Gán / cập nhật" Click="Assign_Click" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="Bỏ gán" Click="Unassign_Click" Padding="14,7"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Giá theo kênh">
                <StackPanel Margin="16">
                    <TextBlock Text="Kênh bán"/><ComboBox x:Name="ChannelBox" DisplayMemberPath="ChannelName" Margin="0,4,0,10"/>
                    <TextBlock Text="Giá cộng thêm so với giá cơ bản"/><TextBox x:Name="ChannelExtraBox" Text="0" Margin="0,4,0,12"/>
                    <Button Content="Lưu giá theo kênh" Click="SaveChannelPrice_Click" Padding="14,7" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#C53030"/>
    </Grid>
</Window>
