<Window x:Class="DineFlow.WPFApp.Features.Management.Menu.ChoiceGroupEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhóm phụ" Width="900" Height="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize">
    <Border Background="White" BorderBrush="#0866E5" BorderThickness="2" CornerRadius="16" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText" Text="Thêm nhóm phụ" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Nhóm Loại = chọn đúng 1 lựa chọn. Nhóm Lựa chọn = chọn nhiều lựa chọn, giới hạn bởi MaxSelect."
                       Foreground="#64748B"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Tên nhóm" Margin="0,0,0,6" FontWeight="SemiBold" />
                <TextBox x:Name="GroupNameTextBox" Padding="9,6" LostFocus="GroupNameTextBox_LostFocus" />
                <TextBlock x:Name="GroupNameValidationText"
                           Foreground="#C53030"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                <TextBlock Text="Nhóm" Margin="0,0,0,6" FontWeight="SemiBold" />
                <WrapPanel>
                    <RadioButton x:Name="TypeRadioButton" Content="Loại" IsChecked="True"
                                 Checked="GroupKind_Changed" Margin="0,0,18,0" />
                    <RadioButton x:Name="OptionRadioButton" Content="Lựa chọn"
                                 Checked="GroupKind_Changed" />
                </WrapPanel>
                <TextBlock Text="MaxSelect" Margin="0,13,0,6" FontWeight="SemiBold" />
                <TextBox x:Name="MaxSelectTextBox" Text="1" Padding="9,6" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Các lựa chọn trong nhóm" FontWeight="Bold" />
            <DataGrid Grid.Row="1" x:Name="ChoiceItemsGrid"
                      ItemsSource="{Binding ChoiceItems, RelativeSource={RelativeSource AncestorType=Window}}"
                      SelectedItem="{Binding SelectedChoiceItem, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      Margin="0,8,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên lựa chọn" Binding="{Binding ChoiceName}" Width="*" />
                    <DataGridTextColumn Header="Giá thêm" Binding="{Binding ExtraPrice, StringFormat={}{0:N0} ₫}" Width="120" />
                    <DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding IsAvailable}" Width="90" />
                    <DataGridTemplateColumn Header="Thao tác" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Sửa" Tag="{Binding}" Click="EditChoice_Click" Padding="10,4" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Grid.RowSpan="2" Background="#F8FAFC" CornerRadius="10" Padding="16" Margin="18,0,0,0">
                <StackPanel>
                    <TextBlock x:Name="ChoiceFormTitle" Text="Thêm lựa chọn" FontWeight="Bold" />
                    <TextBlock Text="Tên lựa chọn" Margin="0,12,0,6" />
                    <TextBox x:Name="ChoiceNameTextBox" Padding="9,6" />
                    <TextBlock Text="Giá cộng thêm" Margin="0,12,0,6" />
                    <TextBox x:Name="ExtraPriceTextBox" Text="0" Padding="9,6" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="AddOrUpdateChoiceButton" Content="Thêm" Click="AddOrUpdateChoice_Click" Padding="13,7" Margin="0,0,8,0" />
                        <Button Content="Làm mới" Click="ResetChoiceForm_Click" Padding="13,7" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <TextBlock x:Name="ErrorText" Foreground="#C53030" TextWrapping="Wrap" Margin="0,0,0,10" Height="Auto" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy" Click="CancelButton_Click" Padding="15,7" Margin="0,0,8,0" />
                    <Button Content="Lưu nhóm" Click="SaveButton_Click" Padding="15,7" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
