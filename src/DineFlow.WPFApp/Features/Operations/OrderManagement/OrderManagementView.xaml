<UserControl x:Class="DineFlow.WPFApp.Features.Operations.OrderManagement.OrderManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:DineFlow.WPFApp.Features.Operations.OrderManagement.Components">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Operations/OrderManagement/Styles/OrderManagement.ShellStyles.xaml" />
                <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Operations/OrderManagement/Styles/OrderManagement.TableStyles.xaml" />
                <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Operations/OrderManagement/Styles/OrderManagement.MenuStyles.xaml" />
                <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Operations/OrderManagement/Styles/OrderManagement.BillStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
<Grid Background="#0B55A0">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="RoomTabButton"
                        Tag="Active"
                        Style="{StaticResource TopTabButtonStyle}"
                        Click="RoomTabButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="19"
                              Height="18"
                              Margin="0,0,9,0"
                              VerticalAlignment="Center">
                            <Border Height="5"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    CornerRadius="1" />
                            <Border Width="2"
                                    Height="9"
                                    Margin="3,7,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Border Width="2"
                                    Height="9"
                                    Margin="0,7,3,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                        <TextBlock Text="Phòng bàn" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="MenuTabButton"
                        Style="{StaticResource TopTabButtonStyle}"
                        Click="MenuTabButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE719;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Margin="0,0,9,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Thực đơn" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="PendingOrdersTabButton"
                        Style="{StaticResource TopTabButtonStyle}"
                        Click="PendingOrdersTabButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77F;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Margin="0,0,9,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Đơn chờ" VerticalAlignment="Center" />
                        <Border x:Name="PendingOrdersBadge"
                                MinWidth="20"
                                Height="20"
                                Margin="7,0,0,0"
                                Padding="5,0"
                                Background="#EF4444"
                                CornerRadius="10"
                                Visibility="Collapsed">
                            <TextBlock x:Name="PendingOrdersBadgeText"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Button>
                <Button x:Name="RequestsTabButton"
                        Style="{StaticResource TopTabButtonStyle}"
                        Click="RequestsTabButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA8F;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Margin="0,0,9,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Yêu cầu" VerticalAlignment="Center" />
                        <Border x:Name="ServiceRequestsBadge"
                                MinWidth="20"
                                Height="20"
                                Margin="7,0,0,0"
                                Padding="5,0"
                                Background="#EF4444"
                                CornerRadius="10"
                                Visibility="Collapsed">
                            <TextBlock x:Name="ServiceRequestsBadgeText"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Grid.Column="1"
                    Height="40"
                    MaxWidth="620"
                    Margin="18,2,8,2"
                    HorizontalAlignment="Stretch"
                    Background="#0A4B8E"
                    BorderBrush="#4B8FD1"
                    BorderThickness="1"
                    CornerRadius="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#CDE4FF"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Grid Grid.Column="1">
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="Tìm kiếm bàn..."
                                   Foreground="#AFCFEB"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <TextBox x:Name="SearchBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="White"
                                 CaretBrush="White"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,12,0"
                                 TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Grid>
            </Border>

        </Grid>

        <Grid Grid.Row="1" Margin="6,0,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="620" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="18"
                    Padding="14">
                <Grid>
                    <Grid x:Name="RoomPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0">
                            <Button x:Name="AllAreaButton"
                                    Content="Tất cả"
                                    CommandParameter="All"
                                    Tag="Active"
                                    Style="{StaticResource RoomAreaFilterButtonStyle}"
                                    Click="AreaButton_Click" />
                            <Button x:Name="FloorOneButton"
                                    Content="Tầng 1"
                                    CommandParameter="Tang 1"
                                    Style="{StaticResource RoomAreaFilterButtonStyle}"
                                    Click="AreaButton_Click" />
                            <Button x:Name="FloorTwoButton"
                                    Content="Tầng 2"
                                    CommandParameter="Tang 2"
                                    Style="{StaticResource RoomAreaFilterButtonStyle}"
                                    Click="AreaButton_Click" />
                            <Button x:Name="VipAreaButton"
                                    Content="VIP"
                                    CommandParameter="VIP"
                                    Style="{StaticResource RoomAreaFilterButtonStyle}"
                                    Click="AreaButton_Click" />
                        </WrapPanel>

                        <WrapPanel Grid.Row="1" Margin="0,2,0,8">
                            <Button x:Name="AllStatusButton"
                                    Content="Tất cả trạng thái"
                                    CommandParameter="All"
                                    Tag="Active"
                                    Style="{StaticResource RoomStatusFilterButtonStyle}"
                                    Click="StatusButton_Click" />
                            <Button x:Name="EmptyStatusButton"
                                    CommandParameter="Available"
                                    Style="{StaticResource RoomStatusFilterButtonStyle}"
                                    Click="StatusButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7"
                                             Height="7"
                                             Margin="0,0,9,0"
                                             Fill="#37C976"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="Bàn trống" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ServingStatusButton"
                                    CommandParameter="Serving"
                                    Style="{StaticResource RoomStatusFilterButtonStyle}"
                                    Click="StatusButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7"
                                             Height="7"
                                             Margin="0,0,9,0"
                                             Fill="#2F80ED"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="Đang có khách" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredTables}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <components:TableCardControl Click="TableTile_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="MenuPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="MenuCatalogPanel" Grid.RowSpan="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="AllCategoryButton"
                                            Content="Tất cả"
                                            CommandParameter="All"
                                            Tag="Active"
                                            Style="{StaticResource FilterButtonStyle}"
                                            Click="CategoryButton_Click" />
                                    <Button Content="Món chính"
                                            CommandParameter="Mon chinh"
                                            Style="{StaticResource FilterButtonStyle}"
                                            Click="CategoryButton_Click" />
                                    <Button Content="Đồ uống"
                                            CommandParameter="Do uong"
                                            Style="{StaticResource FilterButtonStyle}"
                                            Click="CategoryButton_Click" />
                                    <Button Content="Món thêm"
                                            CommandParameter="Mon them"
                                            Style="{StaticResource FilterButtonStyle}"
                                            Click="CategoryButton_Click" />
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredMenuItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MenuTileStyle}"
                                                    Tag="{Binding}"
                                                    Click="MenuTile_Click">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="86" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border Background="{Binding Color}"
                                                            CornerRadius="8,8,0,0">
                                                        <TextBlock Text="{Binding Initials}"
                                                                   Foreground="White"
                                                                   FontSize="26"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Row="1" Margin="8,6">
                                                        <TextBlock Text="{Binding PriceText}"
                                                                   Foreground="#0B55A0"
                                                                   FontWeight="Bold"
                                                                   TextAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="#2D3748"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="34" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Grid.Row="2"
                                       Text="{Binding MenuPageText}"
                                       Foreground="#4A5568"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0" />
                        </Grid>

                        <Grid x:Name="ChoiceSelectionPanel" Grid.RowSpan="3" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="ChoiceItemNameText"
                                               Foreground="#1A202C"
                                               FontSize="22"
                                               FontWeight="Bold" />
                                    <TextBlock x:Name="ChoiceGuideText"
                                               Foreground="#718096"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Quay lại"
                                        Height="34"
                                        MinWidth="86"
                                        Style="{StaticResource FilterButtonStyle}"
                                        Click="CancelChoiceButton_Click" />
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding PendingChoiceGroups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding HeaderText}"
                                                    Tag="{Binding IsActiveTag}"
                                                    Style="{StaticResource FilterButtonStyle}"
                                                    CommandParameter="{Binding}"
                                                    Click="ChoiceGroupTab_Click" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ActiveChoiceOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ChoiceOptionButtonStyle}"
                                                    Tag="{Binding IsSelectedTag}"
                                                    CommandParameter="{Binding}"
                                                    Click="ChoiceOption_Click">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="#1A202C"
                                                               FontWeight="Bold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding ExtraPriceText}"
                                                               Foreground="#0B55A0"
                                                               FontWeight="SemiBold"
                                                               Margin="0,6,0,0" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Grid.Row="3"
                                    Background="#F7FAFC"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Lựa chọn"
                                                   Foreground="#718096"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding PendingChoiceSummary}"
                                                   Foreground="#1A202C"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Thêm vào bill"
                                            Height="42"
                                            MinWidth="132"
                                            Background="#16A34A"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            BorderBrush="#16A34A"
                                            Click="ConfirmChoiceButton_Click" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="PendingOrdersPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <Button x:Name="PendingOrderHistoryButton"
                                    Content="Lịch sử đơn chờ"
                                    DockPanel.Dock="Right"
                                    Height="36"
                                    Padding="16,0"
                                    Background="White"
                                    Foreground="#0866E5"
                                    BorderBrush="#0866E5"
                                    BorderThickness="1"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource RoundCornerButtonStyle}"
                                    Click="PendingOrderHistoryButton_Click" />
                            <TextBlock Text="Đơn khách chờ xác nhận"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#1A202C"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PendingOrders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="16"
                                                Margin="0,0,0,14"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 1. Icon Box -->
                                                <Border x:Name="OrderIconContainer"
                                                        Grid.Column="0"
                                                        Width="58"
                                                        Height="58"
                                                        CornerRadius="12"
                                                        BorderThickness="1"
                                                        Background="#F0F9FF"
                                                        BorderBrush="#E0F2FE"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE7BF;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="24"
                                                               Foreground="#0284C7"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <!-- 2. Table Name & Order Code Stacked -->
                                                 <StackPanel Grid.Column="1"
                                                             VerticalAlignment="Center"
                                                             Margin="16,0,0,0">
                                                     <TextBlock Text="{Binding TableName}"
                                                                FontSize="17"
                                                                FontWeight="Bold"
                                                                Foreground="#0F172A" />
                                                     <TextBlock Text="{Binding OrderCode}"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="#64748B"
                                                                Margin="0,4,0,0" />
                                                 </StackPanel>

                                                <!-- Separator Line 1 -->
                                                <Border Grid.Column="2"
                                                        Width="1"
                                                        Height="46"
                                                        Background="#E2E8F0"
                                                        Margin="20,0"
                                                        VerticalAlignment="Center" />

                                                <!-- 3. Details Area -->
                                                <StackPanel Grid.Column="3"
                                                            VerticalAlignment="Center"
                                                            Margin="0,2,0,0">
                                                    <!-- Row 1: Order Metadata -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE946;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="14"
                                                                   Foreground="#0866E5"
                                                                   Margin="0,2,8,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DetailText}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#1E293B"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- Row 2: Dish list / Items -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE8FD;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="14"
                                                                   Foreground="#4B5563"
                                                                   Margin="0,2,8,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ItemSummary}"
                                                                   FontSize="13"
                                                                   Foreground="#64748B"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Separator Line 2 -->
                                                <Border Grid.Column="4"
                                                        Width="1"
                                                        Height="46"
                                                        Background="#E2E8F0"
                                                        Margin="20,0"
                                                        VerticalAlignment="Center" />

                                                <!-- 4. Action Buttons -->
                                                <StackPanel Grid.Column="5"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Chi tiết"
                                                            Tag="{Binding}"
                                                            Height="38"
                                                            MinWidth="84"
                                                            Margin="0,0,8,0"
                                                            Style="{StaticResource FilterButtonStyle}"
                                                            Click="ViewPendingOrderDetailButton_Click" />
                                                    <Button Content="Hủy"
                                                            Tag="{Binding}"
                                                            Height="38"
                                                            MinWidth="68"
                                                            Margin="0,0,8,0"
                                                            Background="#FEF2F2"
                                                            Foreground="#EF4444"
                                                            FontWeight="Bold"
                                                            BorderBrush="#FECACA"
                                                            Style="{StaticResource RoundCornerButtonStyle}"
                                                            Click="CancelPendingOrderButton_Click" />
                                                    <Button Tag="{Binding}"
                                                            Height="38"
                                                            MinWidth="104"
                                                            Background="#16A34A"
                                                            Foreground="White"
                                                            FontWeight="Bold"
                                                            BorderBrush="#16A34A"
                                                            Style="{StaticResource RoundCornerButtonStyle}"
                                                            Click="ConfirmPendingOrderButton_Click">
                                                        <StackPanel Orientation="Horizontal" Margin="4,0">
                                                            <TextBlock Text="&#xE930;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="13"
                                                                       FontWeight="Normal"
                                                                       Margin="0,2,6,0"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="Xác nhận" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="RequestsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <Button x:Name="ServiceRequestHistoryButton"
                                    Content="Lịch sử yêu cầu"
                                    DockPanel.Dock="Right"
                                    Height="36"
                                    Padding="16,0"
                                    Background="White"
                                    Foreground="#0866E5"
                                    BorderBrush="#0866E5"
                                    BorderThickness="1"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource RoundCornerButtonStyle}"
                                    Click="ServiceRequestHistoryButton_Click" />
                            <TextBlock Text="Yêu cầu của khách"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#1A202C"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ServiceRequests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="16"
                                                Margin="0,0,0,14"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 1. Icon Box -->
                                                <Border x:Name="IconContainer"
                                                        Grid.Column="0"
                                                        Width="58"
                                                        Height="58"
                                                        CornerRadius="12"
                                                        BorderThickness="1"
                                                        Background="#F0F7FF"
                                                        BorderBrush="#D1E9FF"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="IconText"
                                                               Text="&#xE789;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="24"
                                                               Foreground="#0066D6"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <!-- 2. Table Name & Order Code Stacked -->
                                                 <StackPanel Grid.Column="1"
                                                             VerticalAlignment="Center"
                                                             Margin="16,0,0,0">
                                                     <TextBlock Text="{Binding TableName}"
                                                                FontSize="17"
                                                                FontWeight="Bold"
                                                                Foreground="#0F172A" />
                                                     <TextBlock Text="{Binding RequestName}"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="#64748B"
                                                                Margin="0,4,0,0" />
                                                 </StackPanel>

                                                <!-- Separator Line 1 -->
                                                <Border Grid.Column="2"
                                                        Width="1"
                                                        Height="40"
                                                        Background="#E2E8F0"
                                                        Margin="20,0"
                                                        VerticalAlignment="Center" />

                                                <!-- 3. Details Area -->
                                                <StackPanel Grid.Column="3"
                                                            VerticalAlignment="Center"
                                                            Margin="0,2,0,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE1EC;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="14"
                                                                   Foreground="#0866E5"
                                                                   Margin="0,2,8,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DetailText}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#1E293B"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE916;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="14"
                                                                   Foreground="#4B5563"
                                                                   Margin="0,2,8,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding CreatedText}"
                                                                   FontSize="13"
                                                                   Foreground="#64748B"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Separator Line 2 -->
                                                <Border Grid.Column="4"
                                                        Width="1"
                                                        Height="40"
                                                        Background="#E2E8F0"
                                                        Margin="20,0"
                                                        VerticalAlignment="Center" />

                                                <!-- 4. Action Button -->
                                                <Button Grid.Column="5"
                                                        Tag="{Binding}"
                                                        Height="42"
                                                        MinWidth="120"
                                                        Background="#0B84F3"
                                                        Foreground="White"
                                                        FontWeight="Bold"
                                                        BorderBrush="#0B84F3"
                                                        Style="{StaticResource RoundCornerButtonStyle}"
                                                        Click="ConfirmServiceRequestButton_Click"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="4,0">
                                                        <TextBlock Text="&#xE930;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="14"
                                                                   FontWeight="Normal"
                                                                   Margin="0,2,6,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="Xác nhận" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RequestType}" Value="PaymentRequest">
                                                <Setter TargetName="IconText" Property="Text" Value="&#xE8C7;" />
                                                <Setter TargetName="IconText" Property="Foreground" Value="#16A34A" />
                                                <Setter TargetName="IconContainer" Property="Background" Value="#F0FDF4" />
                                                <Setter TargetName="IconContainer" Property="BorderBrush" Value="#DCFCE7" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="#F8FAFC"
                    CornerRadius="18"
                    Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="18,18,0,0"
                            BorderBrush="#E5EDF6"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="SelectedTableHeaderButton"
                                    Content="Chưa chọn bàn"
                                    MinWidth="190"
                                    Style="{StaticResource BillToolbarButtonStyle}"
                                    HorizontalContentAlignment="Left"
                                    Click="SelectedTableHeaderButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Root"
                                                Background="#EFF6FF"
                                                BorderBrush="#CBE0FA"
                                                BorderThickness="1"
                                                CornerRadius="21"
                                                Padding="14,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE80F;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="16"
                                                           Foreground="#075FCB"
                                                           VerticalAlignment="Center" />
                                                <ContentPresenter Grid.Column="1"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  TextElement.FontSize="15"
                                                                  TextElement.FontWeight="Bold"
                                                                  TextElement.Foreground="#075FCB" />
                                                <TextBlock Grid.Column="2"
                                                           Text="&#xE76C;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           Foreground="#075FCB"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#E2EFFF" />
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#7DB5F7" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button MinWidth="142"
                                        Style="{StaticResource BillToolbarButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8EC;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="17"
                                                   Margin="0,0,9,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Bảng giá chung" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="#F8FBFF"
                            BorderBrush="#E5EDF6"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    MinWidth="90"
                                    Style="{StaticResource BillToolbarButtonStyle}"
                                    Click="AddBillButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="Bill" />
                                </StackPanel>
                            </Button>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding CurrentBills}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="42"
                                                    Margin="0,0,8,0"
                                                    Tag="{Binding IsSelectedTag}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White" />
                                                        <Setter Property="BorderBrush" Value="#D8E4F2" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="CornerRadius" Value="21" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F2F7FF" />
                                                                <Setter Property="BorderBrush" Value="#7DB5F7" />
                                                            </Trigger>
                                                            <Trigger Property="Tag" Value="Active">
                                                                <Setter Property="Background" Value="#EFF6FF" />
                                                                <Setter Property="BorderBrush" Value="#075FCB" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="{Binding DisplayName}"
                                                            Tag="{Binding}"
                                                            MinWidth="108"
                                                            Padding="14,0,8,0"
                                                            Style="{StaticResource FlatBillTabButtonStyle}"
                                                            Foreground="#075FCB"
                                                            FontSize="14"
                                                            FontWeight="Bold"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            Click="BillTab_Click" />
                                                    <Button Content="&#xE711;"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            Tag="{Binding}"
                                                            Width="34"
                                                            Style="{StaticResource FlatBillTabButtonStyle}"
                                                            Foreground="#EF4444"
                                                            FontWeight="Bold"
                                                            FontSize="13"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            Click="CancelBillButton_Click" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <StackPanel x:Name="EmptyBillPanel"
                                    VerticalAlignment="Center"
                                    Margin="42,0">
                            <TextBlock Text="Bill đang trống"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#2D3748"
                                       TextAlignment="Center" />
                            <TextBlock Text="Chọn bàn, rồi bấm món trong tab Thực đơn để thêm vào bill."
                                       Foreground="#718096"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <ScrollViewer x:Name="BillLinesScroll"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="BillLinesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White"
                                                BorderBrush="#E4ECF5"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="14"
                                                Margin="12,12,12,0">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#4A6A8A"
                                                                  BlurRadius="7"
                                                                  ShadowDepth="1"
                                                                  Opacity="0.08" />
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="124" />
                                                    <ColumnDefinition Width="108" />
                                                    <ColumnDefinition Width="104" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ItemName}"
                                                               FontSize="18"
                                                               Foreground="#14233A"
                                                               FontWeight="Bold" />
                                                    <TextBlock Text="{Binding ChoiceSummary}"
                                                               Foreground="#7B899C"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Margin="0,7,8,0" />
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        Height="46"
                                                        Width="118"
                                                        Background="White"
                                                        BorderBrush="#D8E4F2"
                                                        BorderThickness="1"
                                                        CornerRadius="11"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="38" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="38" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Content="&#xE738;"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Foreground="#0866E5"
                                                                FontSize="13"
                                                                Tag="{Binding}"
                                                                Click="DecreaseLineButton_Click" />
                                                        <Border Grid.Column="1"
                                                                BorderBrush="#E1E8F0"
                                                                BorderThickness="1,0">
                                                            <TextBlock Text="{Binding Quantity}"
                                                                       TextAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="17"
                                                                       FontWeight="Bold" />
                                                        </Border>
                                                        <Button Grid.Column="2"
                                                                Content="&#xE710;"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Foreground="#0866E5"
                                                                FontSize="14"
                                                                Tag="{Binding}"
                                                                Click="IncreaseLineButton_Click" />
                                                    </Grid>
                                                </Border>

                                                <Border Grid.Column="2"
                                                        Height="46"
                                                        Width="100"
                                                        Background="#FBFDFF"
                                                        BorderBrush="#D8E4F2"
                                                        BorderThickness="1"
                                                        CornerRadius="11"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Padding="10,0">
                                                    <TextBlock Text="{Binding TotalText}"
                                                               Foreground="#14233A"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <Button Width="48"
                                                            Height="50"
                                                            Style="{StaticResource BillToolbarButtonStyle}"
                                                            Padding="0"
                                                            Tag="{Binding}"
                                                            ToolTip="Ghi chú và chi tiết món"
                                                            Click="LineDetailButton_Click">
                                                        <StackPanel>
                                                            <TextBlock Text="&#xE70F;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="16"
                                                                       HorizontalAlignment="Center" />
                                                            <TextBlock Text="Ghi chú"
                                                                       FontSize="10"
                                                                       Margin="0,3,0,0"
                                                                       HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Width="42"
                                                            Height="50"
                                                            Margin="6,0,0,0"
                                                            Style="{StaticResource BillDangerIconButtonStyle}"
                                                            Content="&#xE74D;"
                                                            Tag="{Binding}"
                                                            ToolTip="Giảm hoặc hủy món"
                                                            Click="DecreaseLineButton_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Row="3"
                            Background="White"
                            BorderBrush="#E1EAF4"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,18,18"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="UnnotifiedWarning"
                                    Background="#FFF4DF"
                                    BorderBrush="#F5D7A1"
                                    BorderThickness="0,1,0,1"
                                    Padding="12,9"
                                    Margin="-12,-12,-12,10"
                                    Visibility="Collapsed">
                                <TextBlock Foreground="#A85A00"
                                           TextWrapping="Wrap"
                                           Text="Bạn vừa cập nhật đơn hàng. Nhấn Thông báo để gửi thay đổi đến bar/bếp." />
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button MinWidth="108"
                                            Style="{StaticResource SplitMergeButtonStyle}"
                                            Click="SplitMergeButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8AB;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Text="Tách ghép" />
                                        </StackPanel>
                                    </Button>
                                    <Button MinWidth="122"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource RenameBillButtonStyle}"
                                            Click="RenameBillButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE70F;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Text="Đổi tên bill" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="Tổng tiền"
                                               Foreground="#4A5568"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="BillTotalText"
                                               Text="0"
                                               Foreground="#1A202C"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Height="48"
                                        Style="{StaticResource BillFooterButtonStyle}"
                                        Click="PrintTemporaryBillButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE749;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Margin="0,0,9,0" />
                                        <TextBlock Text="In tạm tính" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1"
                                        x:Name="PaymentButton"
                                        Height="48"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource BillActionFooterButtonStyle}"
                                        Background="#16A34A"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        BorderBrush="#16A34A"
                                        Click="PaymentButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C7;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Margin="0,0,9,0" />
                                        <TextBlock Text="Thanh toán" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NotifyButton"
                                        Grid.Column="2"
                                        Height="48"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource BillActionFooterButtonStyle}"
                                        Background="#F1F5F9"
                                        Foreground="#94A3B8"
                                        FontWeight="Bold"
                                        BorderBrush="#CBD5E1"
                                        IsEnabled="False"
                                        Opacity="0.55"
                                        Click="NotifyButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7E7;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Margin="0,0,9,0" />
                                        <TextBlock Text="Thông báo" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
