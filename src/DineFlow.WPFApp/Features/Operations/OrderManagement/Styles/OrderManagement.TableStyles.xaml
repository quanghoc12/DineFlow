<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="RoomAreaFilterButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="42" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Margin" Value="0,0,12,10" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Foreground" Value="#526174" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#DDE5EE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="21">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#F1F7FF" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#91C3FF" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Root" Property="Background" Value="#2F80ED" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#2F80ED" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="Root" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#2F80ED"
                                                      BlurRadius="10"
                                                      ShadowDepth="2"
                                                      Opacity="0.28" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RoomStatusFilterButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource RoomAreaFilterButtonStyle}">
        <Setter Property="MinWidth" Value="132" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="21">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#F7FAFE" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#91C3FF" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Root" Property="Background" Value="White" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#2F80ED" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="1.5" />
                            <Setter Property="Foreground" Value="#1671DB" />
                            <Setter TargetName="Root" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#2F80ED"
                                                      BlurRadius="8"
                                                      ShadowDepth="1"
                                                      Opacity="0.16" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TableTileStyle" TargetType="Button">
        <Setter Property="Width" Value="138" />
        <Setter Property="Height" Value="138" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Grid.Effect>
                            <DropShadowEffect Color="#51769F"
                                              BlurRadius="9"
                                              ShadowDepth="2"
                                              Opacity="0.12" />
                        </Grid.Effect>
                        <Image x:Name="CardBackground"
                               Source="/DineFlow.WPFApp;component/Assets/TableCards/occupied-card.png"
                               Stretch="Fill" />
                        <Border x:Name="HoverOutline"
                                BorderBrush="Transparent"
                                BorderThickness="1.5"
                                CornerRadius="14"
                                Margin="1" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag.Status, RelativeSource={RelativeSource TemplatedParent}}" Value="Available">
                            <Setter TargetName="CardBackground"
                                    Property="Source"
                                    Value="/DineFlow.WPFApp;component/Assets/TableCards/available-card.png" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag.Status, RelativeSource={RelativeSource TemplatedParent}}" Value="WaitingPayment">
                            <Setter TargetName="HoverOutline" Property="BorderBrush" Value="#F3B64B" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverOutline" Property="BorderBrush" Value="#2F80ED" />
                            <Setter TargetName="Root" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#2F80ED"
                                                      BlurRadius="14"
                                                      ShadowDepth="3"
                                                      Opacity="0.22" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag.IsSelectedTag, RelativeSource={RelativeSource TemplatedParent}}" Value="Active">
                            <Setter TargetName="HoverOutline" Property="BorderBrush" Value="#2F80ED" />
                            <Setter TargetName="HoverOutline" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Root" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#2F80ED"
                                                      BlurRadius="16"
                                                      ShadowDepth="0"
                                                      Opacity="0.28" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
