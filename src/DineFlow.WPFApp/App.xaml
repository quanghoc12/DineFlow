<Application x:Class="DineFlow.WPFApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:DineFlow.WPFApp.ViewModels"
             xmlns:views="clr-namespace:DineFlow.WPFApp.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <DataTemplate DataType="{x:Type viewmodels:UserManagementViewModel}">
                <views:UserManagementView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
