<Window x:Class="DineFlow.WPFApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DineFlow Staff"
        Width="1280"
        Height="760"
        MinWidth="1100"
        MinHeight="680"
        Background="#F4F7FB"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E5EEF8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#243B53" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Root" Property="Background" Value="#2F80ED" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#69A7FF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#102A43">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="DineFlow"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold" />
                    <TextBlock Text="Staff workspace"
                               Foreground="#9FB3C8"
                               FontSize="13"
                               Margin="0,4,0,24" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="DashboardButton"
                            Content="Dashboard"
                            Style="{StaticResource NavButtonStyle}"
                            Click="DashboardButton_Click" />
                    <Button x:Name="OrderButton"
                            Content="Quản lý order"
                            Style="{StaticResource NavButtonStyle}"
                            Click="OrderButton_Click" />
                    <Button x:Name="MenuButton"
                            Content="Quản lý món"
                            Style="{StaticResource NavButtonStyle}"
                            Click="MenuButton_Click" />
                    <Button x:Name="TableButton"
                            Content="Quản lý table"
                            Style="{StaticResource NavButtonStyle}"
                            Click="TableButton_Click" />
                    <Button x:Name="AccountButton"
                            Content="Quản lý tài khoản"
                            Style="{StaticResource NavButtonStyle}"
                            Click="AccountButton_Click" />
                </StackPanel>

                <Border Grid.Row="2"
                        Background="#17324D"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Đăng nhập"
                                   Foreground="#BCCCDC"
                                   FontSize="12" />
                        <TextBlock x:Name="CurrentUserText"
                                   Text="staff01"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                        <Button Content="Đăng xuất"
                                Click="LogoutButton_Click"
                                Margin="0,12,0,0"
                                Padding="8,5"
                                Background="#243B53"
                                Foreground="White"
                                BorderBrush="#486581"
                                Cursor="Hand" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl x:Name="ScreenHost"
                        Grid.Column="1"
                        Margin="24" />
    </Grid>
</Window>
