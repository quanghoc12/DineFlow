<Window x:Class="DineFlow.WPFApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DineFlow Staff"
        Width="1280"
        Height="760"
        MinWidth="1100"
        MinHeight="680"
        Background="#F4F7FB"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9FB3C8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Active Indicator Line on the left -->
                                <Border x:Name="ActiveIndicator" 
                                        Width="4" 
                                        Height="20" 
                                        Background="#3B82F6" 
                                        CornerRadius="2" 
                                        HorizontalAlignment="Left"
                                        Margin="-12,0,0,0"
                                        Visibility="Collapsed"/>
                                
                                <ContentPresenter Grid.Column="1" 
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#17324D" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Root" Property="Background" Value="#1B365D" />
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#69A7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar / Navbar -->
        <Border Grid.Column="0" Background="#102A43">
            <Grid Margin="18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Width="40" Height="40" CornerRadius="10" Background="#0B55A0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="&#xEA37;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DineFlow"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Staff Workspace"
                                   Foreground="#829AB1"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Row="1">
                    <Button x:Name="DashboardButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="DashboardButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Width="20" VerticalAlignment="Center" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OrderButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="OrderButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9C0;" FontFamily="Segoe MDL2 Assets" Width="20" VerticalAlignment="Center" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Quản lý order" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="OrderSidebarBadge"
                                    Grid.Column="1"
                                    MinWidth="20"
                                    Height="20"
                                    Margin="10,0,0,0"
                                    Padding="5,0"
                                    Background="#EF4444"
                                    CornerRadius="10"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="OrderSidebarBadgeText"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="MenuButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA37;" FontFamily="Segoe MDL2 Assets" Width="20" VerticalAlignment="Center" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Quản lý món" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TableButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="TableButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" Width="20" VerticalAlignment="Center" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Quản lý bàn" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AccountButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="AccountButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Width="20" VerticalAlignment="Center" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Quản lý tài khoản" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Current User Profile / Logout Box -->
                <Border Grid.Row="2"
                        Background="#102A43"
                        BorderBrush="#243B53"
                        BorderThickness="0,1,0,0"
                        Padding="0,20,0,0"
                        Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Profile Icon Avatar -->
                        <Border Width="40" Height="40" CornerRadius="20" Background="#243B53" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#9FB3C8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Nhân viên"
                                       Foreground="#829AB1"
                                       FontSize="11" />
                            <TextBlock x:Name="CurrentUserText"
                                       Text="staff01"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,2,0,0" />
                            <Button Content="Đăng xuất"
                                    Click="LogoutButton_Click"
                                    Margin="0,8,0,0"
                                    Padding="10,4"
                                    Background="Transparent"
                                    Foreground="#F87171"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    FontSize="12"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand"
                                    Style="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="Đăng xuất" Foreground="#F87171" Cursor="Hand" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="TextDecorations" Value="Underline"/>
                                                            <Setter Property="Foreground" Value="#F87171"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <ContentControl x:Name="ScreenHost"
                        Grid.Column="1"
                        Margin="24" />
    </Grid>
</Window>
