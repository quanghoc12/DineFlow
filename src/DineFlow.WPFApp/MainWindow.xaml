<Window x:Class="DineFlow.WPFApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DineFlow Staff App" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Left" Width="230" Background="#1F2937" Padding="16">
            <StackPanel>
                <TextBlock Text="DineFlow" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0 0 0 24" />
                <Button Content="Dashboard" Margin="0 4" />
                <Button Content="Bàn / Session" Margin="0 4" />
                <Button Content="Menu / Stock" Margin="0 4" />
                <Button Content="Order / Print" Margin="0 4" />
                <Button Content="Requests" Margin="0 4" />
                <Button Content="Bill / Payment" Margin="0 4" />
            </StackPanel>
        </Border>

        <Grid Margin="24">
            <StackPanel>
                <TextBlock x:Name="txtWelcome" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Đây là shell chung. Member sẽ thêm UserControl/Window theo feature của mình." Margin="0 12 0 0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
