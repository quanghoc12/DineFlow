<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Accent Colors (Avikto Indigo) -->
    <Color x:Key="BrandPrimaryColor">#4F46E5</Color>
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    
    <Color x:Key="BrandPrimaryHoverColor">#4338CA</Color>
    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="{StaticResource BrandPrimaryHoverColor}" />

    <Color x:Key="BrandPrimaryPressedColor">#3730A3</Color>
    <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="{StaticResource BrandPrimaryPressedColor}" />

    <!-- Action Colors -->
    <SolidColorBrush x:Key="ActionSuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="ActionWarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="ActionDangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="ActionDangerHoverBrush" Color="#DC2626" />
    
    <!-- Background Colors (Slate/Cool Tones) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBackgroundHoverBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="ControlBackgroundPressedBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#800F172A" />
    
    <!-- Border Colors -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="ControlBorderFocusedBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="#F1F5F9" />

    <!-- Text Colors (Slate) -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

</ResourceDictionary>
