<Window x:Class="DineFlow.WPFApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập - DineFlow"
        Width="920"
        Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
    <Window.Resources>
        <!-- TextBox Custom Style -->
        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter Property="BorderBrush" Value="#0B55A0" />
                                <Setter Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox Custom Style -->
        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter Property="BorderBrush" Value="#0B55A0" />
                                <Setter Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Login Button Custom Style -->
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="#0B55A0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" Value="#0866E5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Background" Value="#064E90" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Branding Panel with Gradient and Abstract Vectors -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B55A0" Offset="0" />
                    <GradientStop Color="#102A43" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ClipToBounds="True">
                <!-- Decorative background elements -->
                <Ellipse Width="300" Height="300" Fill="White" Opacity="0.03" Margin="-100,-100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Ellipse Width="450" Height="450" Fill="White" Opacity="0.04" Margin="0,0,-150,-150" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                <Ellipse Width="180" Height="180" Fill="White" Opacity="0.02" Margin="50,150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <StackPanel VerticalAlignment="Center" Margin="52">
                    <!-- Brand Icon -->
                    <Border Width="64" Height="64" CornerRadius="16" Background="White" Opacity="0.95" HorizontalAlignment="Left" Margin="0,0,0,28">
                        <TextBlock Text="&#xEA37;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#0B55A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="DineFlow"
                               Foreground="White"
                               FontSize="48"
                               FontWeight="Bold" />
                    <TextBlock Text="Hệ thống quản trị &amp; vận hành nhà hàng toàn diện, trơn tru."
                               Foreground="#CDE4FF"
                               FontSize="16"
                               TextWrapping="Wrap"
                               Margin="0,16,0,0"
                               LineHeight="24" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right Login Form Panel -->
        <Border Grid.Column="1"
                Margin="32"
                Padding="36"
                Background="White"
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="1" Color="#CBD5E1" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Đăng nhập"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#102A43" />
                <TextBlock Text="Vui lòng đăng nhập để tiếp tục vào hệ thống."
                           Margin="0,8,0,30"
                           Foreground="#627D98"
                           FontSize="14"/>

                <TextBlock Text="Tên đăng nhập"
                           FontWeight="SemiBold"
                           Foreground="#243B53"
                           FontSize="13"/>
                <TextBox x:Name="UsernameTextBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource LoginTextBoxStyle}"
                         Margin="0,8,0,20" />

                <TextBlock Text="Mật khẩu"
                           FontWeight="SemiBold"
                           Foreground="#243B53"
                           FontSize="13"/>
                <PasswordBox x:Name="PasswordBox"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Style="{StaticResource LoginPasswordBoxStyle}"
                             Margin="0,8,0,0" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C53030"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0"
                           FontSize="13"/>

                <Button Content="Đăng nhập"
                        Command="{Binding LoginCommand}"
                        IsDefault="True"
                        Style="{StaticResource LoginButtonStyle}"
                        Margin="0,24,0,0" />

                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             Margin="0,16,0,0"
                             Background="#F1F5F9"
                             Foreground="#0866E5"
                             BorderThickness="0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
