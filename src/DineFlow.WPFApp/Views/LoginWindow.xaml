<Window x:Class="DineFlow.WPFApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập - DineFlow"
        Width="880"
        Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#102A43">
            <StackPanel VerticalAlignment="Center" Margin="52">
                <TextBlock Text="DineFlow"
                           Foreground="White"
                           FontSize="46"
                           FontWeight="Bold" />
                <TextBlock Text="Restaurant operations, flowing smoothly."
                           Foreground="#BCCCDC"
                           FontSize="16"
                           Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Margin="32"
                Padding="36"
                Background="White"
                CornerRadius="16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Đăng nhập"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#102A43" />
                <TextBlock Text="Đăng nhập để tiếp tục vào hệ thống."
                           Margin="0,8,0,30"
                           Foreground="#627D98" />

                <TextBlock Text="Tên đăng nhập"
                           FontWeight="SemiBold"
                           Foreground="#243B53" />
                <TextBox x:Name="UsernameTextBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Height="42"
                         Margin="0,8,0,18"
                         Padding="10,7"
                         FontSize="15" />

                <TextBlock Text="Mật khẩu"
                           FontWeight="SemiBold"
                           Foreground="#243B53" />
                <PasswordBox x:Name="PasswordBox"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Height="42"
                             Margin="0,8,0,0"
                             Padding="10,7"
                             FontSize="15" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C53030"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />

                <Button Content="Đăng nhập"
                        Command="{Binding LoginCommand}"
                        IsDefault="True"
                        Height="44"
                        Margin="0,22,0,0"
                        Background="#2F80ED"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        FontSize="15" />

                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             Margin="0,14,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
