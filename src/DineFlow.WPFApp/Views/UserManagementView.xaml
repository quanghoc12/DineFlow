<UserControl x:Class="DineFlow.WPFApp.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Management/Tables/TableManagementStyles.xaml"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#0B55A0" CornerRadius="16" Padding="24,18" Margin="0,0,0,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Quản lý tài khoản" FontSize="27" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Thêm, chỉnh sửa và kiểm soát quyền truy cập của nhân viên."
                               Margin="0,5,0,0" Foreground="#CDE4FF"/>
                </StackPanel>
                <Button Content="+ Thêm người dùng" Click="CreateButton_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource TablePrimaryButtonStyle}"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TableFieldStyle}" ToolTip="Tìm tên đăng nhập hoặc họ tên"/>
                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="#C53030"
                               VerticalAlignment="Center" Margin="16,0"/>
                </Grid>
                <Grid Grid.Row="1" Background="#F4F7FA">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="120"/><ColumnDefinition Width="130"/><ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tên đăng nhập" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Họ và tên" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="Vai trò" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="3" Text="Trạng thái" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="4" Text="Ngày tạo" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="5" Text="Thao tác" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Users}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource ManagementListRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/><ColumnDefinition Width="130"/><ColumnDefinition Width="208"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Username}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FullName}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RoleLabel}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding ActiveStatusLabel}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                                        <Button Content="Sửa" Tag="{Binding}" Click="EditUserRow_Click"
                                                Style="{StaticResource TableSecondaryButtonStyle}"
                                                MinHeight="34" Padding="14,0" Margin="0,0,7,0"/>
                                        <Button Content="Đổi mật khẩu" Tag="{Binding}" Click="ResetPasswordRow_Click"
                                                Style="{StaticResource TableSecondaryButtonStyle}"
                                                MinHeight="34" Padding="14,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
