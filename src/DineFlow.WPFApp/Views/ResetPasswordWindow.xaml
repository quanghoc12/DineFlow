
<Window x:Class="DineFlow.WPFApp.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:DineFlow.WPFApp.ViewModels"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        d:DataContext="{d:DesignInstance Type=viewmodels:ResetPasswordViewModel}"
        mc:Ignorable="d"
        Title="Reset Password" Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource WindowFadeInStoryboard}" />
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Border Style="{StaticResource CardBorderStyle}" Margin="32" VerticalAlignment="Center">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,32" Orientation="Horizontal" HorizontalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="Key" Width="24" Height="24" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Reset Password" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Reset Password For:" Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBlock Grid.Row="2" Text="{Binding Username}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,16" />

                <TextBlock Grid.Row="3" Text="New Password:" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <PasswordBox Grid.Row="4" x:Name="txtNewPassword" PasswordChanged="txtNewPassword_PasswordChanged" Style="{StaticResource StandardPasswordBoxStyle}" Margin="0,0,0,16" />

                <TextBlock Grid.Row="5" Text="Confirm Password:" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <PasswordBox Grid.Row="6" x:Name="txtConfirmPassword" PasswordChanged="txtConfirmPassword_PasswordChanged" Style="{StaticResource StandardPasswordBoxStyle}" Margin="0,0,0,32" />

                <TextBlock Grid.Row="7" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ActionDangerBrush}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16" />

                <Grid Grid.Row="8" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <ProgressBar Grid.Column="0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,16,0" Height="4" Foreground="{DynamicResource BrandPrimaryBrush}" BorderThickness="0" Background="Transparent" />
                    
                    <Button Grid.Column="1" Content="Cancel" Click="BtnCancel_Click" Style="{StaticResource StandardButtonStyle}" Width="80" Margin="0,0,12,0" />
                    <Button Grid.Column="2" Content="Reset" Command="{Binding SaveCommand}" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Width="80" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
