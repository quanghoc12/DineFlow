<Window x:Class="DineFlow.WPFApp.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mật khẩu" Width="620" Height="570" MinWidth="580" MinHeight="540"
        Background="#EEF3F8" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="/DineFlow.WPFApp;component/Features/Management/Tables/TableManagementStyles.xaml"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="84"/></Grid.RowDefinitions>
        <Border Background="#0B55A0" Padding="30,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Đổi mật khẩu" Foreground="White" FontSize="26" FontWeight="Bold"/>
                <TextBlock x:Name="DescriptionText" Foreground="#CDE4FF" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Margin="24" Padding="28,16" Background="White" CornerRadius="16">
            <StackPanel>
                <StackPanel x:Name="CurrentPasswordPanel">
                    <TextBlock Text="Mật khẩu cũ" Style="{StaticResource TableDialogLabelStyle}"/>
                    <PasswordBox x:Name="CurrentPasswordBox" MinHeight="42" Padding="12,8"
                                 BorderBrush="#DDE5EE" BorderThickness="1"/>
                </StackPanel>
                <Border x:Name="OwnerPermissionNotice" Visibility="Collapsed" Background="#EFF6FF"
                        BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="8" Padding="14"
                        Margin="0,18,0,0">
                    <TextBlock Text="Chủ nhà hàng có quyền đặt mật khẩu mới mà không cần mật khẩu cũ."
                               Foreground="#1E40AF" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="Mật khẩu mới" Style="{StaticResource TableDialogLabelStyle}"/>
                <PasswordBox x:Name="NewPasswordBox" MinHeight="42" Padding="12,8"
                             BorderBrush="#DDE5EE" BorderThickness="1"/>
                <TextBlock Text="Xác nhận mật khẩu mới" Style="{StaticResource TableDialogLabelStyle}"/>
                <PasswordBox x:Name="ConfirmPasswordBox" MinHeight="42" Padding="12,8"
                             BorderBrush="#DDE5EE" BorderThickness="1"/>
                <TextBlock Text="Mật khẩu mới phải có ít nhất 6 ký tự."
                           Foreground="#829AB1" Margin="0,9,0,0"/>
                <TextBlock x:Name="ErrorText" Foreground="#C53030" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE5EE" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0">
                <Button Content="Hủy" Click="CancelButton_Click" Style="{StaticResource TableSecondaryButtonStyle}"
                        MinWidth="110" Margin="0,0,10,0"/>
                <Button Content="Cập nhật mật khẩu" Click="SaveButton_Click"
                        Style="{StaticResource TablePrimaryButtonStyle}" MinWidth="180"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
