<Window x:Class="DineFlow.WPFApp.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đặt lại mật khẩu"
        Width="390"
        Height="285"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="28">
        <TextBlock x:Name="DescriptionText" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Mật khẩu mới" Margin="0,24,0,7" FontWeight="SemiBold" />
        <PasswordBox x:Name="NewPasswordBox" Padding="9,6" />
        <TextBlock Text="Xác nhận mật khẩu" Margin="0,14,0,7" FontWeight="SemiBold" />
        <PasswordBox x:Name="ConfirmPasswordBox" Padding="9,6" />
        <TextBlock x:Name="ErrorText" Foreground="#C53030" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Hủy" Click="CancelButton_Click" Padding="15,7" Margin="0,0,8,0" />
            <Button Content="Lưu" Click="SaveButton_Click" Padding="15,7" />
        </StackPanel>
    </StackPanel>
</Window>
