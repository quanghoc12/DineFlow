<Window x:Class="DineFlow.WPFApp.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:DineFlow.WPFApp.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:ResetPasswordViewModel}"
        mc:Ignorable="d"
        Title="Reset Password" Height="350" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reset Password For:" Margin="0,0,0,5" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="{Binding Username}" Margin="0,0,0,15" FontSize="16" />

        <TextBlock Grid.Row="2" Text="New Password:" Margin="0,0,0,5" />
        <PasswordBox Grid.Row="3" x:Name="txtNewPassword" PasswordChanged="txtNewPassword_PasswordChanged" Margin="0,0,0,15" Padding="5" />

        <TextBlock Grid.Row="4" Text="Confirm Password:" Margin="0,0,0,5" />
        <PasswordBox Grid.Row="5" x:Name="txtConfirmPassword" PasswordChanged="txtConfirmPassword_PasswordChanged" Margin="0,0,0,15" Padding="5" />

        <TextBlock Grid.Row="6" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,15" />

        <Grid Grid.Row="7" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <ProgressBar Grid.Column="0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,10,0" Height="20" />
            
            <Button Grid.Column="1" Content="Cancel" Click="BtnCancel_Click" Width="80" Height="30" Margin="0,0,10,0" />
            <Button Grid.Column="2" Content="Reset" Command="{Binding SaveCommand}" IsDefault="True" Width="80" Height="30" />
        </Grid>
    </Grid>
</Window>
