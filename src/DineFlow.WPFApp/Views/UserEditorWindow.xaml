<Window x:Class="DineFlow.WPFApp.Views.UserEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Người dùng"
        Width="430"
        Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB">
    <Border Margin="22" Padding="26" Background="White" CornerRadius="12">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       Text="Thêm người dùng"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#102A43"
                       Margin="0,0,0,22" />
            <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold" />
            <TextBox x:Name="UsernameTextBox" Margin="0,7,0,16" Padding="9,6" />
            <TextBlock Text="Họ và tên" FontWeight="SemiBold" />
            <TextBox x:Name="FullNameTextBox" Margin="0,7,0,16" Padding="9,6" />
            <TextBlock Text="Vai trò" FontWeight="SemiBold" />
            <ComboBox x:Name="RoleComboBox"
                      Margin="0,7,0,16"
                      Padding="8,5"
                      SelectedIndex="1">
                <ComboBoxItem Content="Admin" />
                <ComboBoxItem Content="Staff" />
            </ComboBox>
            <StackPanel x:Name="PasswordPanel">
                <TextBlock Text="Mật khẩu" FontWeight="SemiBold" />
                <PasswordBox x:Name="PasswordBox" Margin="0,7,0,16" Padding="9,6" />
            </StackPanel>
            <TextBlock x:Name="ErrorText"
                       Foreground="#C53030"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Click="CancelButton_Click" Padding="16,8" Margin="0,0,8,0" />
                <Button Content="Lưu"
                        Click="SaveButton_Click"
                        Padding="18,8"
                        Background="#2F80ED"
                        Foreground="White"
                        BorderThickness="0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
