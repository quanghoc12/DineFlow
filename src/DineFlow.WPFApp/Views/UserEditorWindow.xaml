<Window x:Class="DineFlow.WPFApp.Views.UserEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:DineFlow.WPFApp.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:UserEditorViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="450" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Username:" Margin="0,0,0,5" />
        <TextBox Grid.Row="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCreateMode}" Margin="0,0,0,15" Padding="5" />

        <TextBlock Grid.Row="2" Text="Full Name:" Margin="0,0,0,5" />
        <TextBox Grid.Row="3" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Padding="5" />

        <TextBlock Grid.Row="4" Text="Password (Required for new users):" Margin="0,0,0,5" Visibility="{Binding IsCreateMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <PasswordBox Grid.Row="5" x:Name="txtPassword" PasswordChanged="txtPassword_PasswordChanged" Margin="0,0,0,15" Padding="5" Visibility="{Binding IsCreateMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <TextBlock Grid.Row="6" Text="Role:" Margin="0,0,0,5" />
        <ComboBox Grid.Row="7" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="RoleName" Margin="0,0,0,15" Padding="5" />

        <TextBlock Grid.Row="8" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,15" />

        <Grid Grid.Row="9" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <ProgressBar Grid.Column="0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,10,0" Height="20" />
            
            <Button Grid.Column="1" Content="Cancel" Click="BtnCancel_Click" Width="80" Height="30" Margin="0,0,10,0" />
            <Button Grid.Column="2" Content="Save" Command="{Binding SaveCommand}" IsDefault="True" Width="80" Height="30" />
        </Grid>
    </Grid>
</Window>
