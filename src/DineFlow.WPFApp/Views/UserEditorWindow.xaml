
    <Window x:Class="DineFlow.WPFApp.Views.UserEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:DineFlow.WPFApp.ViewModels"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        d:DataContext="{d:DesignInstance Type=viewmodels:UserEditorViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="580" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource WindowFadeInStoryboard}" />
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Border Style="{StaticResource CardBorderStyle}" Margin="32" VerticalAlignment="Center">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,32" Orientation="Horizontal" HorizontalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="AccountEdit" Width="24" Height="24" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Username:" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Grid.Row="2" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCreateMode}" Style="{StaticResource StandardTextBoxStyle}" Margin="0,0,0,16" />

                <TextBlock Grid.Row="3" Text="Full Name:" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Grid.Row="4" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Margin="0,0,0,16" />

                <TextBlock Grid.Row="5" Text="Password (Required for new users):" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4" Visibility="{Binding IsCreateMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <PasswordBox Grid.Row="6" x:Name="txtPassword" PasswordChanged="txtPassword_PasswordChanged" Style="{StaticResource StandardPasswordBoxStyle}" Margin="0,0,0,16" Visibility="{Binding IsCreateMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Grid.Row="7" Text="Role:" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <!-- Standardizing ComboBox via basic styling attributes, full template would require too much XAML here -->
                <ComboBox Grid.Row="8" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="RoleName" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,32" Padding="12,8" MinHeight="36" FontFamily="{StaticResource PrimaryFontFamily}" FontSize="14" />

                <TextBlock Grid.Row="9" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ActionDangerBrush}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16" />

                <Grid Grid.Row="10" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <ProgressBar Grid.Column="0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,16,0" Height="4" Foreground="{DynamicResource BrandPrimaryBrush}" BorderThickness="0" Background="Transparent" />
                    
                    <Button Grid.Column="1" Content="Cancel" Click="BtnCancel_Click" Style="{StaticResource StandardButtonStyle}" Width="80" Margin="0,0,12,0" />
                    <Button Grid.Column="2" Content="Save" Command="{Binding SaveCommand}" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Width="80" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
